(in-package #:cl-stack-code/tests)

;;; Headless sessions end to end (src/headless.lisp header): every -p run is
;;; a turn of a session under the project's private data directory.

(defun json-run (project config argv &rest keys)
  "CODE with --output-format json. → (values exit result-object stderr backend)."
  (multiple-value-bind (exit out err backend)
      (apply #'code project config (append '("-p" "--output-format" "json") argv) keys)
    (values exit (ignore-errors (json:decode (string-right-trim '(#\Newline) out))) err backend)))

(defun result-session (result) (jget result "session_id"))

(deftest session-cli-parses-session-flags
  (let ((i (parse-arguments '("-c" "-p" "hi"))))
    (ok (invocation-continue-p i))
    (ok (null (invocation-resume i))))
  (let ((i (parse-arguments '("--resume" "abcd" "--fork-session" "--session-id"
                              "0123456789abcdef0123456789abcdef" "-p" "x"))))
    (ok (equal "abcd" (invocation-resume i)))
    (ok (invocation-fork-session-p i))
    (ok (equal "0123456789abcdef0123456789abcdef" (invocation-session-id i))))
  (ok (equal "ab12" (invocation-resume (parse-arguments '("-r" "ab12" "-p" "x")))))
  (ok (invocation-list-sessions-p (parse-arguments '("--list-sessions")))))

(deftest-parametrize session-flag-combinations
    ((argv needle)
     :ids ("continue-and-resume" "fork-alone" "session-id-with-resume" "bad-session-id"
           "bad-resume" "list-with-resume")
     ('("-c" "--resume" "abcd") "--continue and --resume")
     ('("--fork-session") "--fork-session needs")
     ('("--resume" "abcd" "--session-id" "0123456789abcdef0123456789abcdef") "needs --fork-session")
     ('("--session-id" "nope") "bad session id")
     ('("--resume" "zz!") "bad session id")
     ('("--list-sessions" "--resume" "abcd") "--list-sessions cannot"))
  (ok (typep (failure (check-session-flags (parse-arguments (append argv '("-p" "x")))))
             'code-usage-error))
  (with-project (project config) '()
    (multiple-value-bind (exit out err) (code project config (append '("-p") argv '("hi"))
                                              :steps '("unused"))
      (ok (eql 2 exit))
      (ok (equal "" out))
      (ok (has needle err) err))))

(deftest headless-run-is-a-session
  (with-project (project config) '()
    (multiple-value-bind (exit result err backend) (json-run project config '("say hi") :steps '("Hi!"))
      (declare (ignore err backend))
      (ok (eql 0 exit))
      (let* ((dir (project-sessions project config))
             (id (result-session result))
             (s (open-session dir id)))
        (ok (same-path (uiop:merge-pathnames* (format nil "sessions/~a/" (project-session-key project))
                                              (data-dir-of config))
                       dir))
        (ok (equal (list id) (directory-names dir)) "one session directory, named by the id")
        (ok (equal '("say hi") (line-prompts s)))
        (let ((record (revision-record (session-head s))))
          (ok (equal "mock" (record-model record)))
          (ok (eq :default (record-permission-mode record)))
          (ok (eq :stop (record-finish record)))
          (ok (equal '(10 5 2 1) (record-usage record)))
          (ok (equal '((:user "say hi") (:assistant "Hi!")) (turn-summaries (record-turns record)))
              "no :system turn is stored"))
        (ok (equal id (session-id (last-session dir))))))))

(deftest resume-carries-the-conversation
  (with-project (project config) '()
    (let ((id (result-session (nth-value 1 (json-run project config '("first") :steps '("one"))))))
      (multiple-value-bind (exit result err backend)
          (json-run project config (list "--resume" id "second") :steps '("two"))
        (declare (ignore err))
        (ok (eql 0 exit))
        (ok (equal id (result-session result)) "the same session")
        (let ((text (request-chat (first-request backend))))
          (ok (has "first" text) "the earlier prompt reaches the model")
          (ok (has "one" text) "and the earlier answer")
          (ok (let ((a (search "first" text)) (b (search "second" text)))
                (and a b (< a b)))
              "in order"))
        (let ((s (open-session (project-sessions project config) id)))
          (ok (equal '("first" "second") (line-prompts s)))
          (ok (equal '((:user "second") (:assistant "two"))
                     (turn-summaries (record-turns (revision-record (session-head s)))))
              "the second revision holds only its own turns"))))))

(deftest resume-by-prefix-and-uuid
  (with-project (project config) '()
    (let ((id (result-session (nth-value 1 (json-run project config '("first") :steps '("one"))))))
      (ok (equal id (result-session (nth-value 1 (json-run project config (list "-r" (subseq id 0 6) "x")
                                                           :steps '("ok"))))))
      (let ((uuid (format nil "~a-~a-~a-~a-~a" (subseq id 0 8) (subseq id 8 12) (subseq id 12 16)
                          (subseq id 16 20) (subseq id 20))))
        (ok (equal id (result-session (nth-value 1 (json-run project config (list "--resume" uuid "y")
                                                             :steps '("ok"))))))))))

(deftest continue-uses-the-last-session
  (with-project (project config) '()
    (let ((a (result-session (nth-value 1 (json-run project config '("in a") :steps '("A")))))
          (b (result-session (nth-value 1 (json-run project config '("in b") :steps '("B"))))))
      (ok (not (equal a b)) "a run without session flags starts a new session")
      (multiple-value-bind (exit result err backend)
          (json-run project config '("-c" "more") :steps '("C"))
        (declare (ignore err))
        (ok (eql 0 exit))
        (ok (equal b (result-session result)))
        (ok (has "in b" (request-chat (first-request backend))))
        (ok (not (has "in a" (request-chat (first-request backend)))))))))

(deftest session-not-found-exits-2
  (with-project (project config) '()
    (multiple-value-bind (exit out err) (code project config '("-p" "-c" "hi") :steps '("x"))
      (ok (eql 2 exit))
      (ok (equal "" out))
      (ok (has "no session to continue" err)))
    (multiple-value-bind (exit out err) (code project config '("-p" "--resume" "abcd" "hi") :steps '("x"))
      (ok (eql 2 exit))
      (ok (equal "" out))
      (ok (has "abcd" err)))
    (ok (null (list-sessions (project-sessions project config))) "nothing was created")))

(deftest session-id-names-a-new-session
  (with-project (project config) '()
    (multiple-value-bind (exit result)
        (json-run project config '("--session-id" "01234567-89AB-CDEF-0123-456789ABCDEF" "hi")
                  :steps '("ok"))
      (ok (eql 0 exit))
      (ok (equal "0123456789abcdef0123456789abcdef" (result-session result))))
    (multiple-value-bind (exit out err)
        (code project config '("-p" "--session-id" "0123456789abcdef0123456789abcdef" "again")
              :steps '("x"))
      (ok (eql 2 exit))
      (ok (equal "" out))
      (ok (has "already exists" err)))))

(deftest fork-session-resumes-into-a-copy
  (with-project (project config) '()
    (let ((id (result-session (nth-value 1 (json-run project config '("first") :steps '("one"))))))
      (multiple-value-bind (exit result err backend)
          (json-run project config (list "--resume" id "--fork-session" "second") :steps '("two"))
        (declare (ignore err))
        (ok (eql 0 exit))
        (let ((new (result-session result))
              (dir (project-sessions project config)))
          (ok (not (equal id new)) "a new session id")
          (ok (has "first" (request-chat (first-request backend))) "with the old history")
          (ok (equal '("first" "second") (line-prompts (open-session dir new))))
          (ok (equal '("first") (line-prompts (open-session dir id))) "the original is untouched")
          (ok (equal (list id (rev:revision-id (session-head (open-session dir id))))
                     (session-cloned-from (open-session dir new))))))
      (multiple-value-bind (exit result)
          (json-run project config (list "-c" "--fork-session" "--session-id"
                                         "feedfacefeedfacefeedfacefeedface" "third")
                    :steps '("three"))
        (ok (eql 0 exit))
        (ok (equal "feedfacefeedfacefeedfacefeedface" (result-session result)))
        (ok (equal '("first" "second" "third")
                   (line-prompts (open-session (project-sessions project config)
                                               "feedfacefeedfacefeedfacefeedface")))
            "--continue picked the fork, the last session")))))

(deftest resumed-session-keeps-its-model
  (with-project (project config) '()
    (let ((id (result-session (nth-value 1 (json-run project config '("first") :steps '("one")
                                                     :model "mock:alpha")))))
      (multiple-value-bind (exit result err backend)
          (json-run project config (list "--resume" id "second") :steps '("two") :model nil)
        (declare (ignore result err))
        (ok (eql 0 exit))
        (ok (equal "alpha" (scripted-model backend)) "the session's model"))
      (multiple-value-bind (exit result err backend)
          (json-run project config (list "--resume" id "third") :steps '("three") :model "mock:beta")
        (declare (ignore result err))
        (ok (eql 0 exit))
        (ok (equal "beta" (scripted-model backend)) "--model wins")
        (ok (equal "mock:beta"
                   (record-model (revision-record (session-head (open-session (project-sessions project config) id))))))))))

(deftest failed-and-max-turn-runs-are-saved
  (with-project (project config) '(("a.txt" "x"))
    (let ((r (nth-value 1 (json-run project config '("break") :steps '((:error "backend down"))))))
      (ok (equal "error_during_execution" (jget r "subtype")))
      (let ((s (open-session (project-sessions project config) (result-session r))))
        (ok (equal '("break") (line-prompts s)))
        (ok (eq :failed (record-finish (revision-record (session-head s)))))))
    (let ((r (nth-value 1 (json-run project config '("--max-turns" "1" "loop")
                                    :steps (list (list :tool "read" (json-args "file_path" "a.txt")))))))
      (ok (equal "error_max_turns" (jget r "subtype")))
      (let ((s (open-session (project-sessions project config) (result-session r))))
        (ok (eq :max-steps (record-finish (revision-record (session-head s)))))))))

(deftest stream-json-carries-the-resumed-session-id
  (with-project (project config) '()
    (let ((id (result-session (nth-value 1 (json-run project config '("first") :steps '("one"))))))
      (multiple-value-bind (exit out)
          (code project config (list "-p" "--output-format" "stream-json" "--resume" id "again")
                :steps '("two words"))
        (ok (eql 0 exit))
        (let ((all (json-lines out)))
          (ok (equal "system" (jget (first all) "type")))
          (ok (every (lambda (e) (equal id (jget e "session_id"))) all)))))))

(deftest list-sessions-prints-this-project
  (with-project (project config) '()
    (multiple-value-bind (exit out err) (code project config '("--list-sessions") :model nil)
      (ok (eql 0 exit) err)
      (ok (equal "" out) "no sessions yet"))
    (json-run project config '("fix the bug") :steps '("done"))
    (multiple-value-bind (exit out) (code project config '("--list-sessions") :model nil)
      (ok (eql 0 exit))
      (ok (= 1 (length (lines out))))
      (ok (equal (session-summary-lines (project-sessions project config)) (lines out)))
      (ok (has "  1 turn  fix the bug" out)))))

(deftest conflicting-process-forks-the-turn
  (with-project (project config) '()
    (let* ((id (result-session (nth-value 1 (json-run project config '("first") :steps '("one")))))
           (gate (make-gate))
           (other-error nil)
           (other (bt:make-thread
                   (lambda ()
                     ;; Another process commits while this run waits at the gate.
                     (unwind-protect
                          (handler-case
                              (progn
                                (loop repeat 2000 until (gate-waiting-p gate) do (sleep 0.01))
                                (commit (open-session (project-sessions project config) id)
                                        "from another process"))
                            (error (e) (setf other-error e)))
                       (open-gate gate)))
                   :name "other process")))
      (multiple-value-bind (exit result err)
          (json-run project config (list "--resume" id "mine") :steps (list (list :gate gate "two")))
        (bt:join-thread other)
        (ok (null other-error) (format nil "the other commit: ~a" other-error))
        (ok (eql 0 exit))
        (let ((new (result-session result))
              (dir (project-sessions project config)))
          (ok (not (equal id new)) "the turn went to a new session")
          (ok (has (format nil "session ~a changed in another process" id) err) err)
          (ok (has new err))
          (ok (equal '("first" "from another process") (line-prompts (open-session dir id))))
          (ok (equal '("first" "mine") (line-prompts (open-session dir new)))))))))

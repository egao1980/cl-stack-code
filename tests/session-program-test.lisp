(in-package #:cl-stack-code/tests)

;;; Sessions and steering in the interactive program (src/program.lisp
;;; header, "H3c"), on the headless TUI with the scripted mock LLM. Each test
;;; reads the project's sessions directory first.

(defun program-session (program dir)
  "The session the program is on, opened from disk."
  (open-session dir (state-session-id (code-program-state program))))

(defun trimmed-rows (tui)
  (mapcar (lambda (row) (string-right-trim " " row)) (screen tui)))

(deftest program-saves-each-turn
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (with-code-tui (tui program backend :steps '("answer one" "answer two")) (project config)
        (let ((id (state-session-id (code-program-state program))))
          (ok (normalize-session-id id) "the program has a session id from the start")
          (ok (null (list-sessions dir)) "nothing on disk before the first turn")
          (send-line tui "one")
          (ok (wait-screen tui "answer one"))
          (ok (wait-idle tui program))
          (send-line tui "two")
          (ok (wait-screen tui "answer two"))
          (ok (wait-idle tui program))
          (ok (equal (list id) (directory-names dir)))
          (let ((s (open-session dir id)))
            (ok (equal '("one" "two") (line-prompts s)))
            (ok (equal '((:user "two") (:assistant "answer two"))
                       (turn-summaries (record-turns (revision-record (session-head s)))))
                "each revision holds its own turn")
            (ok (equal '(10 5 2 1) (record-usage (revision-record (session-head s)))))))))))

(deftest program-resumes-a-session
  (with-project (project config) '()
    (let* ((dir (project-sessions project config))
           (s (create-session dir :project-dir project)))
      (commit-turn s (tool-record "read a.txt"))
      (with-code-tui (tui program backend :steps '("next answer")
                          :argv (list "--resume" (session-id s)))
          (project config)
        (ok (wait-screen tui "It says alpha.") "the transcript is restored")
        (ok (on-screen tui "> read a.txt"))
        (ok (on-screen tui "● read a.txt"))
        (ok (equal (session-id s) (state-session-id (code-program-state program))))
        (h:tui-press tui :arrow-up)
        (ok (wait-for* tui (lambda () (equal "read a.txt"
                                             (w:text-input-value (code-program-input program)))))
            "the history holds the session's prompts")
        (ctrl tui :c)
        (send-line tui "next")
        (ok (wait-screen tui "next answer"))
        (ok (wait-idle tui program))
        (let ((text (request-chat (first-request backend))))
          (ok (has "read a.txt" text))
          (ok (has "It says alpha." text)))
        (ok (equal '("read a.txt" "next") (line-prompts (open-session dir (session-id s)))))))))

(deftest program-continue-and-resume-errors
  (with-project (project config) '()
    (let* ((dir (project-sessions project config))
           (s (create-session dir)))
      (ok (typep (failure (make-program project config :argv '("--continue"))) 'session-not-found)
          "no session to continue: signalled before the terminal")
      (ok (typep (failure (make-program project config :argv '("--resume" "abcd")))
                 'session-not-found))
      (commit s "earlier")
      (with-code-tui (tui program backend :argv '("-c")) (project config)
        (ok (wait-screen tui "> earlier"))
        (ok (equal (session-id s) (state-session-id (code-program-state program))))))))

(deftest program-tree-snapshot
  (with-project (project config) '()
    (let* ((dir (project-sessions project config))
           (s (tree-fixture dir)))
      (with-code-tui (tui program backend :argv (list "--resume" (session-id s)) :rows 30)
          (project config)
        (ok (wait-screen tui "> another third"))
        (send-line tui "/tree")
        (ok (wait-screen tui "(head)"))
        (let* ((rows (trimmed-rows tui))
               (at (position "● aaaaaaaa first question" rows :test #'string=)))
          (ok at "the tree's first line is a row of its own")
          (ok (and at (equal '("● aaaaaaaa first question"
                               "● bbbbbbbb second question"
                               "├─ ○ cccccccc third question"
                               "│  ○ eeeeeeee fifth question"
                               "└─ ● dddddddd another third  (head)")
                             (subseq rows at (min (length rows) (+ at 5)))))
              "the tree rows, exactly"))))))

(deftest program-rewind
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (with-code-tui (tui program backend :steps '("answer one" "answer two" "answer other"))
          (project config)
        (send-line tui "one")
        (ok (wait-screen tui "answer one"))
        (send-line tui "two")
        (ok (wait-screen tui "answer two"))
        (ok (wait-idle tui program))
        (send-line tui "/rewind")
        (ok (wait-screen tui "rewound 1 turn"))
        (ok (not (on-screen tui "answer two")) "the transcript is the head's")
        (ok (on-screen tui "answer one"))
        (send-line tui "other")
        (ok (wait-screen tui "answer other"))
        (ok (wait-idle tui program))
        (let ((text (request-chat (third (scripted-requests backend)))))
          (ok (has "one" text))
          (ok (not (has "answer two" text)) "the rewound turn is not sent"))
        (let ((s (program-session program dir)))
          (ok (equal '("one" "other") (line-prompts s)))
          (ok (= 2 (length (rev:heads s))) "the rewound turn stays as a branch"))))))

(deftest program-fork-puts-the-prompt-back
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (with-code-tui (tui program backend :steps '("answer one" "answer two" "answer again"))
          (project config)
        (send-line tui "one")
        (ok (wait-screen tui "answer one"))
        (send-line tui "two")
        (ok (wait-screen tui "answer two"))
        (ok (wait-idle tui program))
        (send-line tui "/fork")
        (ok (wait-screen tui "forked before turn"))
        (ok (wait-for* tui (lambda () (equal "two" (w:text-input-value (code-program-input program)))))
            "the forked turn's message is back in the input")
        (h:tui-type tui " again")
        (h:tui-press tui :enter)
        (ok (wait-screen tui "answer again"))
        (ok (wait-idle tui program))
        (let ((s (program-session program dir)))
          (ok (equal '("one" "two again") (line-prompts s)))
          (ok (= 2 (length (rev:revision-children s (rev:revision-id (first (session-line s))))))))))))

(deftest program-clone-switches-sessions
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (with-code-tui (tui program backend :cols 160 :steps '("answer one" "answer more")) (project config)
        (send-line tui "one")
        (ok (wait-screen tui "answer one"))
        (ok (wait-idle tui program))
        (let ((old (state-session-id (code-program-state program))))
          (send-line tui "/clone")
          (ok (wait-screen tui "cloned session"))
          (let ((new (state-session-id (code-program-state program))))
            (ok (not (equal old new)))
            (ok (on-screen tui (format nil "cloned session ~a as ~a" old new)))
            (send-line tui "more")
            (ok (wait-screen tui "answer more"))
            (ok (wait-idle tui program))
            (ok (equal '("one" "more") (line-prompts (open-session dir new))))
            (ok (equal '("one") (line-prompts (open-session dir old))))
            (ok (has "one" (request-chat (second (scripted-requests backend))))
                "the conversation goes on in the clone")))))))

(deftest program-export
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (declare (ignorable dir))
      (with-code-tui (tui program backend :steps '("answer one")) (project config)
        (send-line tui "one")
        (ok (wait-screen tui "answer one"))
        (ok (wait-idle tui program))
        (let ((id (state-session-id (code-program-state program))))
          (send-line tui "/export notes/s.md")
          (ok (wait-screen tui "exported 1 turn to"))
          (ok (uiop:string-prefix-p (format nil "# Session ~a~%" id) (or (read-file project "notes/s.md") "")))
          (ok (has (nl "**Assistant**" "" "answer one") (read-file project "notes/s.md")))
          (send-line tui "/export s.json")
          (ok (wait-for* tui (lambda () (probe-file (merge-pathnames "s.json" project)))))
          (ok (equal id (jget (json:decode (read-file project "s.json")) "session_id"))))))))

(deftest program-clear-starts-a-new-session
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (with-code-tui (tui program backend :steps '("answer one" "answer two")) (project config)
        (send-line tui "one")
        (ok (wait-screen tui "answer one"))
        (ok (wait-idle tui program))
        (let ((old (state-session-id (code-program-state program))))
          (send-line tui "/clear")
          (ok (wait-for* tui (lambda () (not (equal old (state-session-id (code-program-state program)))))))
          (send-line tui "two")
          (ok (wait-screen tui "answer two"))
          (ok (wait-idle tui program))
          (ok (= 2 (length (list-sessions dir))))
          (ok (equal '("two") (line-prompts (program-session program dir))))
          (ok (equal '("one") (line-prompts (open-session dir old)))))))))

;;; Steering.

(deftest program-steering-reaches-the-running-turn
  (with-project (project config) '(("a.txt" "alpha"))
    (let ((dir (project-sessions project config))
          (gate (make-gate)))
      (with-code-tui (tui program backend :gates (list gate)
                          :steps (list (list :gate gate (list :tool "read" (json-args "file_path" "a.txt")))
                                       "done"))
          (project config)
        (send-line tui "go")
        (ok (wait-for* tui (lambda () (gate-waiting-p gate))))
        (h:tui-type tui "also check b")
        (ctrl tui :t)
        (ok (wait-screen tui "steering: also check b"))
        (ok (equal "" (w:text-input-value (code-program-input program))) "the input is taken")
        (ok (equal '("also check b") (state-steering (code-program-state program))))
        (open-gate gate)
        (ok (wait-screen tui "done"))
        (ok (wait-idle tui program))
        (ok (= 2 (length (scripted-requests backend))) "no extra turn")
        (ok (has "also check b" (request-chat (second (scripted-requests backend))))
            "the steering reached the model in the same turn")
        (ok (not (on-screen tui "steering:")))
        (let ((rows (mapcar (lambda (n) (row-index tui n)) '("> go" "● read a.txt" "> also check b" "done"))))
          (ok (and (every #'identity rows) (apply #'< rows)) "transcript order"))
        (let ((record (revision-record (session-head (program-session program dir)))))
          (ok (equal '("also check b") (record-steering record)))
          (ok (equal "go" (record-prompt record))))))))

(deftest program-ctrl-t-when-idle-sends
  (with-project (project config) '()
    (let ((dir (project-sessions project config)))
      (declare (ignorable dir))
      (with-code-tui (tui program backend :steps '("hello back")) (project config)
        (ok (wait-screen tui "Message, @file"))
        (h:tui-type tui "hello")
        (ctrl tui :t)
        (ok (wait-screen tui "hello back"))
        (ok (on-screen tui "> hello"))))))

(deftest program-steering-and-follow-up-rows
  (with-project (project config) '()
    (let ((dir (project-sessions project config))
          (gate (make-gate)))
      (declare (ignorable dir))
      (with-code-tui (tui program backend :gates (list gate)
                          :steps (list (list :gate gate "first") "second" "third"))
          (project config)
        (send-line tui "one")
        (ok (wait-for* tui (lambda () (gate-waiting-p gate))))
        (send-line tui "follow")
        (h:tui-type tui "steer")
        (ctrl tui :t)
        (ok (wait-screen tui "steering: steer"))
        (let ((steering (row-index tui "steering: steer"))
              (queued (row-index tui "queued: follow"))
              (spinner (row-index tui "Working…")))
          (ok (and steering queued spinner (= (1+ steering) queued) (= (1+ queued) spinner))
              "steering rows sit above the queued rows"))
        (open-gate gate)
        (ok (wait-screen tui "third"))
        (ok (wait-idle tui program))
        (let ((requests (scripted-requests backend)))
          (ok (= 3 (length requests)))
          (ok (has "steer" (request-chat (second requests))) "the steering went into the running turn")
          (ok (not (has "follow" (request-chat (second requests)))))
          (ok (has "follow" (request-chat (third requests))) "the follow-up waited for the turn"))))))

(deftest program-interrupt-restores-steering
  (with-project (project config) '()
    (let ((dir (project-sessions project config))
          (gate (make-gate)))
      (declare (ignorable dir))
      (with-code-tui (tui program backend :gates (list gate)
                          :steps (list (list :gate gate "late") "after"))
          (project config)
        (send-line tui "one")
        (ok (wait-for* tui (lambda () (gate-waiting-p gate))))
        (h:tui-type tui "steer me")
        (ctrl tui :t)
        (ok (wait-screen tui "steering: steer me"))
        (h:tui-press tui :escape)
        ;; A lone Esc is reported only after the input read times out; let it
        ;; register before the gated reply goes on.
        (sleep 0.5)
        (open-gate gate)
        (ok (wait-screen tui "interrupted"))
        (ok (wait-idle tui program))
        (ok (wait-for* tui (lambda () (equal "steer me" (w:text-input-value (code-program-input program))))))
        (ok (= 1 (length (scripted-requests backend))))
        (ctrl tui :c)
        (send-line tui "again")
        (ok (wait-screen tui "after"))
        (ok (not (has "steer me" (request-chat (second (scripted-requests backend)))))
            "an interrupted steering message is not sent later")))))

(deftest program-session-conflict-forks
  (with-project (project config) '()
    (let* ((dir (project-sessions project config))
           (s (create-session dir)))
      (commit s "earlier")
      (let ((gate (make-gate)))
        (with-code-tui (tui program backend :cols 160 :gates (list gate) :argv (list "--resume" (session-id s))
                            :steps (list (list :gate gate "mine")))
            (project config)
          (send-line tui "my turn")
          (ok (wait-for* tui (lambda () (gate-waiting-p gate))))
          (commit (open-session dir (session-id s)) "from another process")
          (open-gate gate)
          (ok (wait-screen tui "changed in another process"))
          (ok (wait-idle tui program))
          (let ((new (state-session-id (code-program-state program))))
            (ok (not (equal (session-id s) new)))
            (ok (on-screen tui (format nil "continuing as session ~a" new)))
            (ok (equal '("earlier" "my turn") (line-prompts (open-session dir new))))
            (ok (equal '("earlier" "from another process")
                       (line-prompts (open-session dir (session-id s)))))))))))

(in-package #:cl-stack-code/tests)

;;; H3e-2a: the MCP servers as the instruction set's :MCP-SERVERS component
;;; (src/mcp.lisp, "The instruction set"): the snapshot, the role in every
;;; session, the init event's revision (SDK and -p), a commit when a server is
;;; added, a rewind to before a server was added, a fork.

(defun %session-iset-store (session)
  "The instruction store of SDK SESSION."
  (session-instruction-store (code-session-store session)))

(defun %init-set (session)
  (event-value (code-session-init session) "instruction_set"))

(defun %mcp-snapshot (store id)
  "The :MCP-SERVERS snapshot of revision ID in STORE."
  (snapshot-of store id :mcp-servers))

(defun %snapshot-server (snapshot name)
  (find name snapshot :key (lambda (s) (getf s :name)) :test #'equal))

(defun %snapshot-tool (server name)
  (find name (getf server :tools) :key (lambda (s) (getf s :name)) :test #'equal))

(defun %sha256-ref-p (x)
  (and (stringp x) (uiop:string-prefix-p "sha256:" x) (hex-64-p (subseq x 7))))

(defun %mcp-tools-of (request server)
  "The offered tool names of REQUEST that belong to SERVER."
  (remove-if-not (lambda (n) (uiop:string-prefix-p (format nil "mcp__~a__" server) n))
                 (request-tool-names request)))

(defun %late-servers (base)
  "A decoded mcpServers object with the fake server as \"late\"."
  (jget (json:decode (mcp-servers-json "late" (fake-stdio-server base))) "mcpServers"))

(deftest mcp-iset-snapshot
  (with-project (project config :base base) '()
    (write-user-settings config "mcpServers"
                         (args "fake" (fake-stdio-server base :env '("FAKE_TOKEN" "s3cret-token"))))
    (with-test-client (client backend events project config :steps '("done"))
      (let* ((s (client-new-session client))
             (store (%session-iset-store s))
             (alist (read-instruction-set store (%init-set s)))
             (servers (cdr (assoc :mcp-servers alist)))
             (fake (%snapshot-server servers "fake")))
        (ok (eq :mcp-servers (car (car (last alist)))) "the component comes after the built-in ones")
        (ok (= 1 (length servers)))
        (ok fake)
        (ok (eq :user (getf fake :scope)))
        (ok (eq :stdio (getf fake :transport)))
        (ok (eq :connected (getf fake :status)) "the init event's revision has the settled servers")
        (ok (%sha256-ref-p (getf fake :config)))
        (ok (null (getf fake :instructions)) "server instructions are H3e-2b's")
        (ok (same-set +fake-stdio-tools+ (mapcar (lambda (tool) (getf tool :name)) (getf fake :tools)))
            "the server's own names")
        (let ((echo (%snapshot-tool fake "echo"))
              (note (%snapshot-tool fake "write_note")))
          (ok (equal "Echo msg" (instruction-text store (getf echo :description))))
          (ok (equal "object" (jget (json:decode (instruction-text store (getf echo :schema))) "type")))
          (ok (eq t (getf echo :read-only)))
          (ok (null (getf note :read-only))))
        (ok (not (search "s3cret-token" (prin1-to-string alist)))
            "env values never reach a revision")
        (ok (not (search "s3cret-token" (instruction-text store (getf (%snapshot-tool fake "env") :description)))))))))

(deftest mcp-iset-role-without-servers
  (with-project (project config) '()
    (with-test-client (client backend events project config :steps '("done"))
      (let* ((s (client-new-session client))
             (store (%session-iset-store s))
             (alist (read-instruction-set store (%init-set s)))
             (start (session-instruction-set (code-session-store s) "0")))
        (ok (assoc :mcp-servers alist) "every session has the role")
        (ok (null (cdr (assoc :mcp-servers alist))))
        (ok start)
        (when start
          (ok (assoc :mcp-servers (read-instruction-set store start))
              "the start revision has it too"))))))

(deftest mcp-iset-init-event-cli
  (with-project (project config :base base) '()
    (write-user-settings config "mcpServers" (args "fake" (fake-stdio-server base)))
    (multiple-value-bind (exit out err)
        (code project config '("-p" "go" "--output-format" "stream-json") :steps '("done"))
      (ok (eql 0 exit) err)
      (let* ((init (init-of out))
             (id (jget init "instruction_set"))
             (session (open-session (project-sessions project config) (jget init "session_id")))
             (store (session-instruction-store session))
             (fake (%snapshot-server (%mcp-snapshot store id) "fake")))
        (ok (hex-64-p id))
        (ok fake "the init event's revision, on disk, has the server")
        (ok (eq :connected (getf fake :status)))
        (ok (same-set +fake-stdio-tools+ (mapcar (lambda (tool) (getf tool :name)) (getf fake :tools))))
        (ok (equal id (record-instructions (first (session-records session))))
            "the turn ran with that set")))))

(deftest mcp-iset-commit-on-add
  (with-project (project config :base base) '()
    (with-test-client (client backend events project config :steps '("one" "two"))
      (let* ((s (client-new-session client))
             (id (code-session-id s))
             (init-set (%init-set s)))
        (client-query s "first" :timeout 60)
        (client-add-mcp-servers s (%late-servers base))
        (client-query s "second" :timeout 60)
        (let* ((records (session-dir-records project config id))
               (r1 (record-instructions (first records)))
               (r2 (record-instructions (second records)))
               (store (%session-iset-store s)))
          (ok (equal init-set r1) "nothing changed in turn 1")
          (ok (not (equal r1 r2)) "adding a server commits a new revision")
          (ok (null (%mcp-snapshot store r1)))
          (ok (eq :connected (getf (%snapshot-server (%mcp-snapshot store r2) "late") :status))))))))

(deftest mcp-iset-rewind-drops-a-later-server
  (with-project (project config :base base) '()
    (with-test-client (client backend events project config :steps '("one" "two" "three"))
      (let* ((s (client-new-session client))
             (id (code-session-id s))
             (sup (code-session-supervisor s)))
        (client-query s "first" :timeout 60)
        (client-add-mcp-servers s (%late-servers base))
        (client-query s "second" :timeout 60)
        (ok (same-set (mcp-names "late") (%mcp-tools-of (second (scripted-requests backend)) "late"))
            "turn 2 offers the added server's tools")
        (let ((r1 (record-instructions (first (session-dir-records project config id)))))
          (client-rewind s 1 :mode :conversation)
          (client-query s "third" :timeout 60)
          (ok (null (%mcp-tools-of (third (scripted-requests backend)) "late"))
              "after the rewind to turn 1 the next model call has none of them")
          (ok (null (server-object (client-mcp-servers s) "late")) "nor does mcp/list")
          (ok (wait-until (lambda ()
                            (every (lambda (u) (member (sup:unit-state u) '(:exited :failed :killed)))
                                   (sup:find-units sup :kind :mcp-server)))
                          :timeout 10)
              "its unit is stopped")
          (let ((records (session-dir-records project config id)))
            (ok (equal '("first" "third") (mapcar #'record-prompt records)))
            (ok (equal r1 (record-instructions (second records)))
                "the turn after the rewind ran with turn 1's set (the same revision)")))))))

(deftest mcp-iset-fork-copies
  (with-project (project config :base base) '()
    (with-test-client (client backend events project config :steps '("one" "two"))
      (let* ((ed (jget (json:decode (mcp-servers-json "ed" (fake-stdio-server base))) "mcpServers"))
             (s (client-new-session client :mcp-servers ed))
             (id (code-session-id s)))
        (client-query s "first" :timeout 60)
        (client-add-mcp-servers s (%late-servers base))
        (client-query s "second" :timeout 60)
        (let* ((r1 (record-instructions (first (session-dir-records project config id))))
               (f (client-fork-session s :at 1))
               (fork-store (%session-iset-store f))
               (fork-servers (event-value (code-session-init f) "mcp_servers")))
          (ok (equal r1 (%init-set f))
              "the fork starts with the fork point's set (same servers, same state: same id)")
          (ok (equal '("ed") (mapcar (lambda (e) (getf e :name)) (%mcp-snapshot fork-store r1)))
              "the clone's store has the fork point's revision, :mcp-servers included")
          (ok (equal "connected" (jget (server-object fork-servers "ed") "status"))
              "an SDK server of the fork point carries over")
          (ok (null (server-object fork-servers "late")) "a server added after the fork point does not")
          (ok (not (eq (code-session-supervisor f) (code-session-supervisor s))))
          (ok (sup:find-units (code-session-supervisor f) :kind :mcp-server)
              "the fork runs its own server unit")
          (ok (server-object (client-mcp-servers s) "late") "the parent keeps its servers"))))))

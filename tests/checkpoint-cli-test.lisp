(in-package #:cl-stack-code/tests)

;;; H5b: checkpoints in -p runs, --list-checkpoints, --rewind and the
;;; checkpoints settings (src/headless.lisp header, "H5b"; src/settings.lisp).

;;; Settings.

(deftest settings-checkpoints-object
  (let ((s (parse-settings "{\"checkpoints\":{\"enabled\":false,\"keep\":3,\"kind\":\"jj\"}}")))
    (ok (equal '(nil 3 :jj) (multiple-value-list (checkpoint-settings s))))
    (ok (equal '(nil 3 :jj) (list (getf (settings-checkpoints s) :enabled :absent)
                                  (getf (settings-checkpoints s) :keep)
                                  (getf (settings-checkpoints s) :kind)))))
  (ok (equal (list t +default-checkpoint-keep+ :auto)
             (multiple-value-list (checkpoint-settings (parse-settings "{}")))))
  (ok (equal '(t 50 :auto) (multiple-value-list (checkpoint-settings (make-settings)))))
  (ok (equal '(t 50 :auto) (multiple-value-list (checkpoint-settings nil))))
  (let ((m (merge-settings (parse-settings "{\"checkpoints\":{\"enabled\":false,\"keep\":3}}")
                           (parse-settings "{\"checkpoints\":{\"keep\":7}}"))))
    (ok (equal '(nil 7 :auto) (multiple-value-list (checkpoint-settings m))) "merged per key"))
  (let ((m (merge-settings (parse-settings "{\"checkpoints\":{\"enabled\":false}}")
                           (parse-settings "{\"checkpoints\":{\"enabled\":true}}"))))
    (ok (eq t (checkpoint-settings m)) "a later true wins over false")))

(deftest-parametrize settings-checkpoints-errors
    ((json key)
     :ids ("not-an-object" "enabled" "keep-zero" "keep-float" "kind")
     ("{\"checkpoints\":true}" "checkpoints")
     ("{\"checkpoints\":{\"enabled\":\"yes\"}}" "checkpoints.enabled")
     ("{\"checkpoints\":{\"keep\":0}}" "checkpoints.keep")
     ("{\"checkpoints\":{\"keep\":2.5}}" "checkpoints.keep")
     ("{\"checkpoints\":{\"kind\":\"svn\"}}" "checkpoints.kind"))
  (let ((c (failure (parse-settings json))))
    (ok (typep c 'settings-error))
    (ok (and (typep c 'settings-error) (equal key (settings-error-key c))))))

(deftest cli-checkpoint-settings
  (with-project (project config) '(("a.txt" "alpha"))
    (write-settings-file (local-settings config project) "{\"checkpoints\":{\"enabled\":false}}")
    (let ((id (edit-run-session project config (list (write-tool "a.txt" "beta") "Done."))))
      (ok (equal "beta" (read-file project "a.txt")))
      (ok (null (session-checkpoints (cli-session project config id))) "enabled false: none")))
  (with-project (project config) '(("a.txt" "alpha"))
    (write-settings-file (local-settings config project) "{\"checkpoints\":{\"keep\":1}}")
    (let* ((id (edit-run-session project config (list (write-tool "a.txt" "beta") "Done.")))
           (s (cli-session project config id)))
      (ok (equal '(:turn) (reasons (session-checkpoints s))) "keep 1")
      (ok (= 2 (length (session-checkpoints s :all t))))))
  (with-git-project (project config) '(("a.txt" "alpha"))
    (write-settings-file (local-settings config project) "{\"checkpoints\":{\"kind\":\"copy\"}}")
    (let ((id (edit-run-session project config (list (write-tool "a.txt" "beta") "Done."))))
      (ok (equal '(:copy :copy) (mapcar #'checkpoint-files-kind
                                        (session-checkpoints (cli-session project config id))))
          "kind copy in a git repository")))
  (with-project (project config) '(("a.txt" "alpha"))
    (write-settings-file (local-settings config project) "{\"checkpoints\":{\"kind\":\"git\"}}")
    (multiple-value-bind (exit out err backend)
        (edit-run project config (list (write-tool "a.txt" "beta") "Done."))
      (ok (eql 1 exit))
      (ok (equal "" out) "nothing written before the error")
      (ok (has "checkpoints.kind git: " err))
      (ok (has "is not a git worktree" err))
      (ok (null (scripted-requests backend)) "the run did not start")
      (ok (equal "alpha" (read-file project "a.txt"))))))

;;; Turns.

(defun cli-turn-records-checkpoints-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha
"))
    (multiple-value-bind (exit out err) (edit-run project config (list (write-tool "a.txt" (nl "beta")) "Done."))
      (ok (eql 0 exit) err)
      (let* ((id (session-id-of out))
             (s (cli-session project config id))
             (ks (session-checkpoints s)))
        (ok (equal '(:before :turn) (reasons ks)))
        (ok (equal (rev:revision-id (session-head s)) (checkpoint-turn-id (second ks))))
        (ok (eq kind (checkpoint-files-kind (second ks))))
        (ok (equal (nl "beta") (checkpoint-file (second ks) s project "a.txt")))
        (ok (null (set-difference (remove-duplicates (mapcar (lambda (e) (jget e "type")) (json-lines out))
                                                     :test #'equal)
                                  '("system" "text_delta" "assistant" "tool_use" "tool_result" "result")
                                  :test #'equal))
            "the stream is H5a's: no checkpoint events")
        (multiple-value-bind (exit2 out2 err2)
            (edit-run project config '("Nothing to do.") :argv (list "--resume" id))
          (declare (ignore out2))
          (ok (eql 0 exit2) err2)
          (ok (= 2 (length (session-checkpoints (cli-session project config id))))
              "a run that changes nothing adds none"))))))

(deftest-parametrize cli-turn-records-checkpoints
    ((kind) :ids ("copy" "git") (:copy) (:git))
  (cli-turn-records-checkpoints-case kind))

(deftest cli-failed-turn-records-checkpoints
  (with-project (project config) '(("a.txt" "alpha"))
    (multiple-value-bind (exit out) (edit-run project config (list (write-tool "a.txt" "beta") '(:error "boom")))
      (ok (eql 1 exit))
      (ok (equal '(:before :turn) (reasons (session-checkpoints (cli-session project config (session-id-of out)))))
          "a failed turn's edits are checkpointed too"))))

(deftest cli-plan-apply-records-checkpoints
  (with-project (project config) '(("a.txt" "alpha"))
    (multiple-value-bind (exit out err) (plan-run project config (list (write-tool "a.txt" "beta") "Done.") "--apply")
      (ok (eql 0 exit) err)
      (ok (equal "beta" (read-file project "a.txt")))
      (let* ((id (session-id-of out))
             (s (cli-session project config id))
             (ks (session-checkpoints s)))
        (ok (equal '(:plan-before :plan-after) (reasons ks)) "and no :turn checkpoint on top")
        (ok (every (lambda (k) (equal (rev:revision-id (session-head s)) (checkpoint-turn-id k))) ks)
            "they belong to the turn that ran the plan")
        (multiple-value-bind (exit2 out2 err2)
            (code project config (list "-p" "--resume" id "--rewind" "0" "--rewind-mode" "files"))
          (declare (ignore out2))
          (ok (eql 0 exit2) err2)
          (ok (equal "alpha" (read-file project "a.txt")) "the approved plan is undone"))))))

(deftest cli-plan-action-apply-records-checkpoints
  (with-project (project config) '(("a.txt" "alpha"))
    (multiple-value-bind (exit out) (plan-run project config (list (write-tool "a.txt" "beta") "Done."))
      (ok (eql 0 exit))
      (let ((id (session-id-of out)))
        (multiple-value-bind (exit2 out2 err2) (code project config (list "-p" "--resume" id "--apply"))
          (declare (ignore out2))
          (ok (eql 0 exit2) err2)
          (let ((s (cli-session project config id)))
            (ok (equal '(:plan-before :plan-after) (reasons (session-checkpoints s))))
            (ok (equal (rev:revision-id (session-head s))
                       (checkpoint-turn-id (first (session-checkpoints s))))
                "the head: the plan's turn")))))))

;;; --list-checkpoints.

(deftest cli-list-checkpoints
  (with-project (project config) '(("a.txt" "alpha"))
    (let ((id (edit-run-session project config (list (write-tool "a.txt" "beta") "Done."))))
      (multiple-value-bind (exit out err) (code project config (list "--resume" id "--list-checkpoints"))
        (ok (eql 0 exit) err)
        (ok (equal (format nil "~{~a~%~}" (checkpoint-summary-lines (cli-session project config id))) out))
        (ok (= 2 (length (lines out)))))
      (multiple-value-bind (exit out) (code project config (list "-p" "-c" "--list-checkpoints"))
        (ok (eql 0 exit))
        (ok (= 2 (length (lines out))) "with -p and --continue too")))
    (let ((id (edit-run-session project config '("Nothing."))))
      (multiple-value-bind (exit out) (code project config (list "--resume" id "--list-checkpoints"))
        (ok (eql 0 exit))
        (ok (equal (nl "no checkpoints yet") out))))))

;;; --rewind.

(deftest-parametrize cli-rewind-flag-errors
    ((argv needle)
     :ids ("mode-alone" "with-prompt" "no-session" "with-apply" "with-fork" "bad-turn" "bad-mode"
           "without-p" "list-alone" "list-with-prompt" "on-drift-alone")
     ('("-p" "--rewind-mode" "files" "x") "--rewind-mode needs --rewind")
     ('("-p" "-c" "--rewind" "1" "x") "--rewind needs --resume or --continue and no prompt")
     ('("-p" "--rewind" "1") "--rewind needs --resume or --continue and no prompt")
     ('("-p" "-c" "--rewind" "1" "--apply") "--rewind cannot be combined with --apply or --reject")
     ('("-p" "-c" "--fork-session" "--rewind" "1") "--rewind and --list-checkpoints cannot be combined with --fork-session")
     ('("-p" "-c" "--rewind" "one") "bad --rewind \"one\": use a turn number or a turn id from /tree")
     ('("-p" "-c" "--rewind" "1" "--rewind-mode" "all") "unknown --rewind-mode \"all\"")
     ('("-c" "--rewind" "1") "--rewind needs -p (use /rewind in the interactive mode)")
     ('("--list-checkpoints") "--list-checkpoints needs --resume or --continue")
     ('("-c" "--list-checkpoints" "x") "--list-checkpoints cannot be combined with --rewind or a prompt")
     ('("-p" "--on-drift" "rebase" "x") "--on-drift needs --apply or --rewind"))
  (with-project (project config) '(("a.txt" "alpha"))
    (multiple-value-bind (exit out err backend) (code project config argv :steps '("unused") :input "from stdin")
      (ok (eql 2 exit))
      (ok (equal "" out))
      (ok (has needle err) err)
      (ok (null (scripted-requests backend)))
      (ok (null (list-sessions (project-sessions project config))) "no session was made"))))

(deftest cli-check-rewind-flags
  (flet ((inv (&rest argv) (parse-arguments argv)))
    (ok (check-rewind-flags (inv "-p" "x")) "no rewind flag")
    (ok (check-rewind-flags (inv "-p" "-c" "--rewind" "0")))
    (ok (check-rewind-flags (inv "-p" "--resume" "abcd" "--rewind" "3" "--rewind-mode" "files")))
    (ok (check-rewind-flags (inv "-p" "-c" "--rewind" "1a2b")) "an id prefix")
    (ok (check-rewind-flags (inv "-c" "--list-checkpoints")))
    (ok (typep (failure (check-rewind-flags (inv "-p" "-c" "--rewind" "1a2"))) 'code-usage-error)
        "a prefix shorter than 4")
    (ok (equal "2" (invocation-rewind (inv "-p" "-c" "--rewind" "2"))))
    (ok (eq :conversation (invocation-rewind-mode (inv "-p" "-c" "--rewind" "2" "--rewind-mode" "conversation"))))
    (ok (null (invocation-rewind-mode (inv "-p" "-c" "--rewind" "2"))))
    (ok (invocation-list-checkpoints-p (inv "-c" "--list-checkpoints")))))

(defun cli-rewind-text-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha
"))
    (let ((id (edit-run-session project config (list (write-tool "a.txt" (nl "beta")) "Done."))))
      (multiple-value-bind (exit out err backend)
          (code project config (list "-p" "--resume" id "--rewind" "0"))
        (ok (eql 0 exit) err)
        (ok (equal (expected-diff (list (list "a.txt" (nl "beta") (nl "alpha")))) out)
            "the restored change as a unified diff")
        (ok (has (format nil "cl-stack-code: session ~a rewound to turn 0: conversation and files (1 file changed)" id)
                 err))
        (ok (equal (nl "alpha") (read-file project "a.txt")))
        (ok (null (scripted-requests backend)) "no LLM call")
        (let ((s (cli-session project config id)))
          (ok (null (session-head s)) "the conversation is back at its start")
          (ok (eq :rewind (checkpoint-reason (tip-checkpoint s)))))))))

(deftest-parametrize cli-rewind-text
    ((kind) :ids ("copy" "git") (:copy) (:git))
  (cli-rewind-text-case kind))

(defun cli-rewind-modes-case (mode file prompts)
  (with-project (project config) '(("a.txt" "zero"))
    (let ((id (edit-run-session project config (list (write-tool "a.txt" "one") "Done.") :prompt "one")))
      (edit-run project config (list (write-tool "a.txt" "two") "Done.") :prompt "two" :argv (list "--resume" id))
      (multiple-value-bind (exit out err)
          (code project config (list "-p" "--resume" id "--rewind" "1" "--rewind-mode" mode))
        (ok (eql 0 exit) err)
        (ok (equal file (read-file project "a.txt")))
        (ok (equal prompts (line-prompts (cli-session project config id))))
        (when (string= mode "conversation")
          (ok (equal "" out) "no diff for the conversation alone")
          (ok (has (format nil "session ~a rewound to turn 1: conversation" id) err)))
        (when (string= mode "files")
          (ok (has (format nil "session ~a rewound to turn 1: files (1 file changed)" id) err)))))))

(deftest-parametrize cli-rewind-modes
    ((mode file prompts)
     :ids ("both" "conversation" "files")
     ("both" "one" '("one"))
     ("conversation" "two" '("one"))
     ("files" "one" '("one" "two")))
  (cli-rewind-modes-case mode file prompts))

(deftest cli-rewind-json
  (with-project (project config) '(("a.txt" "zero"))
    (let ((id (edit-run-session project config (list (write-tool "a.txt" "one") "Done.") :prompt "one")))
      (edit-run project config (list (write-tool "a.txt" "two") "Done.") :prompt "two" :argv (list "--resume" id))
      (multiple-value-bind (exit out err)
          (code project config (list "-p" "--output-format" "stream-json" "--resume" id "--rewind" "1"))
        (ok (eql 0 exit) err)
        (ok (equal '("rewind" "result") (mapcar (lambda (e) (jget e "type")) (json-lines out))))
        (let ((ev (first (events out "rewind")))
              (result (car (last (events out "result")))))
          (ok (equal id (jget ev "session_id")))
          (ok (eql 1 (jget ev "turn")))
          (ok (equal '("conversation" "files") (coerce (jget ev "parts") 'list)))
          (ok (equal "moved" (jget ev "conversation")))
          (ok (equal "applied" (jget ev "files")))
          (ok (equal '(("modified" "a.txt")) (json-changes (jget ev "changes"))))
          (ok (equalp #() (jget ev "conflicts")))
          (ok (equalp #() (jget ev "drift")))
          (ok (equal (checkpoint-id (tip-checkpoint (cli-session project config id))) (jget ev "checkpoint")))
          (ok (equal "success" (jget result "subtype")))
          (ok (equal id (jget result "session_id")))
          (ok (eql 0 (jget result "num_turns")))
          (ok (equal "" (jget result "result")))
          (ok (equal "applied" (jget result "rewind" "files")))
          (ok (equal "moved" (jget result "rewind" "conversation")))))
      (multiple-value-bind (exit out err)
          (code project config (list "-p" "--output-format" "json" "--resume" id "--rewind" "0"
                                     "--rewind-mode" "conversation"))
        (ok (eql 0 exit) err)
        (ok (= 1 (length (lines out))) "json: one result line")
        (let ((r (first (json-lines out))))
          (ok (equal "result" (jget r "type")))
          (ok (eql 0 (jget r "rewind" "turn")))
          (ok (equal "skipped" (jget r "rewind" "files")))
          (ok (equal "moved" (jget r "rewind" "conversation")))
          (ok (eq :null (jget r "rewind" "checkpoint"))))))))

(defun cli-rewind-drift-case (on-drift exit expected)
  (with-project (project config) '(("a.txt" "alpha
"))
    (let ((id (edit-run-session project config (list (write-tool "a.txt" (nl "beta")) "Done."))))
      (write-file project "a.txt" (nl "user"))
      (multiple-value-bind (code-exit out err)
          (code project config (append (list "-p" "--resume" id "--rewind" "0" "--rewind-mode" "files")
                                       (and on-drift (list "--on-drift" on-drift))))
        (ok (eql exit code-exit) err)
        (ok (equal (ecase expected
                     (:user (nl "user"))
                     (:alpha (nl "alpha"))
                     (:merged (rewind-merge (nl "beta") (nl "alpha") (nl "user"))))
                   (read-file project "a.txt")))
        (ecase expected
          (:user
           (ok (equal "" out))
           (ok (has "cl-stack-code: rewind to turn 0: the working copy changed at a.txt; nothing restored (use --on-drift rebase or --on-drift overwrite)"
                    err)))
          (:alpha
           (ok (has (format nil "session ~a rewound to turn 0: files (1 file changed)" id) err)))
          (:merged
           (ok (has (format nil "session ~a rewound to turn 0: files (1 file changed, merged with the working copy; conflicts in a.txt)" id)
                    err))))))))

(deftest-parametrize cli-rewind-drift
    ((on-drift exit expected)
     :ids ("default" "abort" "overwrite" "rebase")
     (nil 1 :user) ("abort" 1 :user) ("overwrite" 0 :alpha) ("rebase" 0 :merged))
  (cli-rewind-drift-case on-drift exit expected))

(deftest cli-rewind-drift-stream-json
  (with-project (project config) '(("a.txt" "alpha"))
    (let ((id (edit-run-session project config (list (write-tool "a.txt" "beta") "Done."))))
      (write-file project "a.txt" "user")
      (multiple-value-bind (exit out)
          (code project config (list "-p" "--output-format" "stream-json" "--resume" id "--rewind" "0"))
        (ok (eql 1 exit))
        (let ((ev (first (events out "rewind")))
              (result (car (last (events out "result")))))
          (ok (equal "aborted" (jget ev "files")))
          (ok (equal "unchanged" (jget ev "conversation")))
          (ok (equal '("a.txt") (coerce (jget ev "drift") 'list)))
          (ok (eq :null (jget ev "checkpoint")))
          (ok (equal "error_during_execution" (jget result "subtype"))))
        (ok (session-head (cli-session project config id)) "the head did not move")))))

(deftest cli-rewind-without-a-checkpoint
  (with-project (project config) '(("a.txt" "alpha"))
    (let ((id (edit-run-session project config '("Nothing.") :prompt "look")))
      (multiple-value-bind (exit out err) (code project config (list "-p" "--resume" id "--rewind" "0"))
        (ok (eql 2 exit))
        (ok (equal "" out))
        (ok (has (format nil "session ~a has no checkpoint for turn 0" id) err))
        (ok (session-head (cli-session project config id)) "nothing moved"))
      (multiple-value-bind (exit out err) (code project config (list "-p" "--resume" id "--rewind" "5"))
        (declare (ignore out))
        (ok (eql 1 exit) "an unknown turn")
        (ok (has "5" err)))
      (multiple-value-bind (exit out err)
          (code project config (list "-p" "--resume" id "--rewind" "0" "--rewind-mode" "conversation"))
        (declare (ignore out))
        (ok (eql 0 exit) err)
        (ok (null (session-head (cli-session project config id))))))))

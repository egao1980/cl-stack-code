(in-package #:cl-stack-code/tests)

;;; H3d: cl-stack-code --rpc (src/rpc.lisp): flags, the error table, run-cli
;;; on string streams, and round trips through SERVE-RPC on an in-memory
;;; stdio pair with an RPC-CLIENT on the other end.

;;; Flags.

(deftest rpc-flags-parse
  (let ((i (parse-arguments '("--rpc" "--cwd" "x" "--model" "mock" "--preview-area" "copy"
                              "--permission-mode" "acceptEdits"))))
    (ok (invocation-rpc-p i))
    (ok (eq t (check-rpc-flags i)))
    (ok (not (invocation-rpc-p (parse-arguments '("-p" "hi")))))
    (ok (eq t (check-rpc-flags (parse-arguments '("-p" "hi")))) "no --rpc: nothing to check")))

(deftest-parametrize rpc-flag-errors
    ((argv needle)
     :ids ("print" "prompt" "output-format" "continue" "resume" "list-sessions" "apply" "rewind")
     ('("--rpc" "-p") "--rpc and -p cannot be used together")
     ('("--rpc" "hello") "--rpc takes no prompt")
     ('("--rpc" "--output-format" "json") "--output-format is for -p")
     ('("--rpc" "--continue") "--rpc opens sessions with session/new and session/resume")
     ('("--rpc" "--resume" "abcd") "--rpc opens sessions with session/new and session/resume")
     ('("--rpc" "--list-sessions") "--rpc opens sessions with session/new and session/resume")
     ('("--rpc" "--apply") "--rpc applies previews with preview/apply")
     ('("--rpc" "--rewind" "1") "--rpc applies previews with preview/apply"))
  (with-project (project config) '()
    (multiple-value-bind (exit out err) (code project config argv)
      (ok (eql 2 exit))
      (ok (equal "" out) "nothing on the protocol stream")
      (ok (has needle err) err))))

(deftest rpc-bad-cwd-exit-2
  (with-project (project config) '()
    (multiple-value-bind (exit out err)
        (code project config (list "--rpc" "--cwd" (native (merge-pathnames "missing/" project))) :cwd nil)
      (ok (eql 2 exit))
      (ok (equal "" out))
      (ok (has "is not a directory" err)))))

;;; The error table.

(deftest rpc-constants
  (ok (equal '("initialize" "session/new" "session/resume" "session/list" "session/fork"
               "session/close" "turn/start" "turn/steer" "turn/interrupt" "approval/respond"
               "plan/approve" "plan/reject" "plan/revise" "plan/get" "plan/update" "plan/save"
               "preview/apply" "preview/reject" "checkpoint/list" "rewind" "settings/get" "tools/list"
               "units/list" "units/subscribe" "units/unsubscribe" "units/read" "units/search"
               "units/control" "mcp/list" "mcp/reconnect" "session/compact" "turn/retry")
             +rpc-methods+))
  (ok (equal "event" +rpc-event-method+))
  (ok (eql 1 +rpc-protocol-version+))
  (ok (eql -32603 (cdr (assoc 'error +rpc-error-codes+)))))

(deftest-parametrize rpc-error-for-conditions
    ((condition code name)
     :ids ("session-not-found" "session-not-open" "turn-busy" "turn-not-running"
           "approval-not-found" "session-conflict" "session-turn-not-found" "plan-not-found"
           "plan-drift" "checkpoint-not-found" "checkpoint-expired" "settings-error"
           "model-not-found" "lisp-image-error" "session-locked" "client-closed"
           "code-usage-error" "permission-rule-error" "run-failed" "simple-error")
     ((make-condition 'session-not-found :designator "abcd") -32001 "session-not-found")
     ((make-condition 'session-not-open :id "abcd") -32002 "session-not-open")
     ((make-condition 'turn-busy :session-id "abcd") -32003 "turn-busy")
     ((make-condition 'turn-not-running :session-id "abcd") -32004 "turn-not-running")
     ((make-condition 'approval-not-found :id "call-1-1") -32005 "approval-not-found")
     ((make-condition 'session-conflict) -32006 "session-conflict")
     ((make-condition 'session-turn-not-found :designator "7") -32007 "session-turn-not-found")
     ((make-condition 'plan-not-found :designator "p") -32008 "plan-not-found")
     ((make-condition 'plan-drift :paths '("a.txt")) -32008 "plan-drift")
     ((make-condition 'checkpoint-not-found :designator "3") -32009 "checkpoint-not-found")
     ((make-condition 'checkpoint-expired) -32009 "checkpoint-expired")
     ((make-condition 'settings-error :key "maxTurns" :message "bad") -32010 "settings-error")
     ((make-condition 'model-not-found :designator "nope:x") -32011 "model-not-found")
     ((make-condition 'lisp-image-error :message "no image") -32012 "lisp-image-error")
     ((make-condition 'session-locked) -32013 "session-locked")
     ((make-condition 'client-closed) -32014 "client-closed")
     ((make-condition 'code-usage-error :message "bad flag") -32602 "code-usage-error")
     ((make-condition 'permission-rule-error :text "x(") -32602 "permission-rule-error")
     ((make-condition 'run-failed :message "boom") -32000 "run-failed")
     ((make-condition 'simple-error :format-control "plain ~a" :format-arguments '(1)) -32603 "simple-error"))
  (multiple-value-bind (got message data) (rpc-error-for condition)
    (ok (eql code got))
    (ok (equal (princ-to-string condition) message))
    (ok (equal name (event-value data "condition")))))

(deftest rpc-error-for-data-fields
  (flet ((data (c) (nth-value 2 (rpc-error-for c))))
    (ok (equal "abcd" (event-value (data (make-condition 'session-not-found :designator "abcd")) "designator")))
    (ok (equal "abcd" (event-value (data (make-condition 'session-not-open :id "abcd")) "session_id")))
    (ok (equal "abcd" (event-value (data (make-condition 'turn-busy :session-id "abcd")) "session_id")))
    (ok (equal "call-1-1" (event-value (data (make-condition 'approval-not-found :id "call-1-1")) "id")))
    (ok (equal "nope:x" (event-value (data (make-condition 'model-not-found :designator "nope:x")) "designator")))
    (let ((d (data (make-condition 'settings-error :key "maxTurns"))))
      (ok (equal "maxTurns" (event-value d "key")))
      (ok (eq :null (event-value d "file"))))
    (let ((own (make-condition 'rpc:rpc-error :code -32099 :message "mine" :data (args "x" 1))))
      (multiple-value-bind (code message data) (rpc-error-for own)
        (ok (eql -32099 code) "an rpc-error keeps its code")
        (ok (equal "mine" message))
        (ok (eql 1 (event-value data "x")) "and its data")))))

;;; run-cli --rpc on string streams (no turns, so nothing races).

(defun rpc-lines (&rest requests)
  (format nil "~{~a~%~}" requests))

(defun response-for (objects id)
  (find-if (lambda (o) (and (hash-table-p o) (eql id (gethash "id" o)) (not (gethash "method" o))))
           objects))

(deftest rpc-run-cli-on-streams
  (with-project (project config) '()
    (multiple-value-bind (exit out err)
        (code project config '("--rpc")
              :input (rpc-lines (rpc:encode-request "initialize" (args) :id 1)
                                (rpc:encode-request "session/new" (args) :id 2)
                                (rpc:encode-request "session/list" (args) :id 3)
                                (rpc:encode-request "no/such" (args) :id 4)
                                (rpc:encode-request "turn/start" (args "session_id" "ffff" "prompt" "x") :id 5)
                                (rpc:encode-request "turn/start" (args "prompt" 42) :id 6)))
      (ok (eql 0 exit) "EOF ends the server")
      (ok (equal "" err) err)
      (let* ((objects (json-lines out))
             (init (response-for objects 1))
             (new (response-for objects 2)))
        (ok (every (lambda (o) (equal "2.0" (gethash "jsonrpc" o))) objects) "only JSON-RPC on output")
        (ok (equal "cl-stack-code" (event-value init "result" "name")))
        (ok (equal "0.16.2" (event-value init "result" "version")))
        (ok (eql 1 (event-value init "result" "protocol")))
        (ok (equal +rpc-methods+ (coerce (event-value init "result" "methods") 'list)))
        (ok (equal +event-types+ (coerce (event-value init "result" "events") 'list)))
        (ok (equal "system" (event-value new "result" "type")) "session/new → the init object")
        (ok (equal "mock" (event-value new "result" "model")))
        (let ((note (find-if (lambda (o) (equal "event" (gethash "method" o))) objects)))
          (ok note "the init object is also a notification")
          (ok (null (gethash "id" note)))
          (ok (equalp (event-value new "result") (gethash "params" note))))
        (ok (equalp #() (event-value (response-for objects 3) "result" "sessions")))
        (ok (eql -32601 (event-value (response-for objects 4) "error" "code")))
        (ok (eql -32002 (event-value (response-for objects 5) "error" "code")))
        (ok (eql -32602 (event-value (response-for objects 6) "error" "code")))
        (ok (= 6 (count-if (lambda (o) (gethash "id" o)) objects)) "one response per request")))))

;;; Round trips.

(deftest rpc-turn-round-trip
  (with-project (project config) '(("a.txt" "alpha
"))
    (with-rpc (rpc backend project config :steps (list (read-step "a.txt") "It says alpha."))
      (let ((init (call rpc "initialize")))
        (ok (equal "cl-stack-code" (event-value init "name"))))
      (let* ((id (new-session rpc))
             (started (call rpc "turn/start" "session_id" id "prompt" "read it"))
             (result (rpc-result rpc id)))
        (ok (hex-id-p id))
        (ok (equal id (event-value started "session_id")))
        (ok result "the result notification")
        (ok (equal "success" (event-value result "subtype")))
        (ok (equal "It says alpha." (event-value result "result")))
        (let ((types (mapcar #'event-type (rpc-client-events rpc :session-id id))))
          (ok (equal "system" (first types)))
          (ok (equal "result" (car (last types))))
          (ok (equal '("system" "assistant" "tool_use" "tool_result" "assistant" "result")
                     (remove "text_delta" types :test #'string=))))))))

(deftest rpc-events-are-stream-json
  (let ((steps (list (read-step "a.txt") "Done reading.")))
    (with-project (project config) '(("a.txt" "alpha
"))
      (let ((lines (json-lines (nth-value 1 (code project config
                                                  '("-p" "--output-format" "stream-json" "go")
                                                  :steps steps)))))
        (with-project (project2 config2) '(("a.txt" "alpha
"))
          (with-rpc (rpc backend project2 config2 :steps steps)
            (let ((id (new-session rpc)))
              (call rpc "turn/start" "session_id" id "prompt" "go")
              (rpc-result rpc id)
              (let ((events (rpc-client-events rpc :session-id id)))
                (ok (same-events-p (rest lines) (rest events))
                    "the notifications are -p's stream-json objects")
                (ok (equal (remove "cwd" (remove "project_root" (jkeys (first lines)) :test #'string=)
                                   :test #'string=)
                           (remove "cwd" (remove "project_root" (jkeys (first events)) :test #'string=)
                                   :test #'string=))
                    "the init object has -p's keys")))))))))

(deftest rpc-turn-busy-and-unknown-session
  (with-project (project config) '()
    (let ((gate (make-gate)))
      (with-rpc (rpc backend project config :steps (list (list :gate gate "Done.")))
        (let ((id (new-session rpc)))
          (call rpc "turn/start" "session_id" id "prompt" "one")
          (ok (wait-until (lambda () (gate-waiting-p gate))))
          (multiple-value-bind (code data) (fault rpc "turn/start" "session_id" id "prompt" "two")
            (ok (eql -32003 code))
            (ok (equal "turn-busy" (event-value data "condition")))
            (ok (equal id (event-value data "session_id"))))
          (open-gate gate)
          (ok (rpc-result rpc id)))
        (multiple-value-bind (code data) (fault rpc "turn/start" "session_id" "ffffffff" "prompt" "x")
          (ok (eql -32002 code))
          (ok (equal "ffffffff" (event-value data "session_id"))))
        (ok (eql -32601 (fault rpc "turn/begin")))))))

(deftest-parametrize rpc-invalid-params
    ((method params needle)
     :ids ("no-prompt" "prompt-not-a-string" "bad-mode" "bad-decision" "rewind-without-turn"
           "mentions-not-strings")
     ("turn/start" '() "turn/start: prompt")
     ("turn/start" '("prompt" 42) "turn/start: prompt")
     ("session/new" '("permission_mode" "nope") "session/new: permission_mode")
     ("approval/respond" '("id" "call-1-1" "decision" "maybe") "approval/respond: decision")
     ("rewind" '() "rewind: turn")
     ("turn/start" '("prompt" "x" "mentions" (1 2)) "turn/start: mentions"))
  (with-project (project config) '()
    (with-rpc (rpc backend project config)
      (let* ((id (new-session rpc))
             (kv (append (unless (equal method "session/new") (list "session_id" id)) params))
             (kv (mapcar (lambda (v) (if (consp v) (coerce v 'vector) v)) kv)))
        (multiple-value-bind (code data message) (apply #'fault rpc method kv)
          (declare (ignore data))
          (ok (eql -32602 code))
          (ok (has needle message) message))))))

(deftest rpc-params-must-be-an-object
  (with-project (project config) '()
    (with-rpc (rpc backend project config)
      (ok (eql -32602 (handler-case (progn (rpc-client-call rpc "session/list" #(1 2) :timeout 30) nil)
                        (rpc:rpc-error (e) (rpc:rpc-error-code e))))))))

(deftest rpc-approval-round-trip
  (with-project (project config) '()
    (with-rpc (rpc backend project config :steps (list (write-step "a.txt" "hi") "Wrote it."))
      (let ((id (new-session rpc)))
        (call rpc "turn/start" "session_id" id "prompt" "write")
        (let ((req (rpc-client-wait-event rpc (type-is "approval_request" id))))
          (ok req "an approval_request notification")
          (ok (equal "write" (event-value req "name")))
          (multiple-value-bind (code data) (fault rpc "approval/respond" "session_id" id
                                                  "id" "nope" "decision" "once")
            (ok (eql -32005 code))
            (ok (equal "nope" (event-value data "id"))))
          (let ((answer (call rpc "approval/respond" "session_id" id
                              "id" (event-value req "id") "decision" "once")))
            (ok (equalp (vector (event-value req "id")) (event-value answer "resolved")))))
        (ok (equal "success" (event-value (rpc-result rpc id) "subtype")))
        (ok (equal "hi" (read-file project "a.txt")))
        (ok (rpc-client-wait-event rpc (type-is "approval_resolved" id)))))))

(deftest rpc-steer-and-interrupt
  (with-project (project config) '()
    (let ((gate (make-gate)))
      (with-rpc (rpc backend project config :steps (list (list :gate gate "Never seen.")))
        (let ((id (new-session rpc)))
          (ok (eql -32004 (fault rpc "turn/steer" "session_id" id "text" "x")) "idle")
          (ok (eq nil (event-value (call rpc "turn/interrupt" "session_id" id) "interrupted")))
          (call rpc "turn/start" "session_id" id "prompt" "slow")
          (ok (wait-until (lambda () (gate-waiting-p gate))))
          (ok (eq t (event-value (call rpc "turn/steer" "session_id" id "text" "late") "posted")))
          (ok (eq t (event-value (call rpc "turn/interrupt" "session_id" id) "interrupted")))
          (open-gate gate)
          (let ((result (rpc-result rpc id)))
            (ok (equal "error_during_execution" (event-value result "subtype")))
            (ok (has "interrupted" (event-value result "error"))))
          (ok (equal "dropped" (event-value (first (rpc-client-events rpc :type "steering" :session-id id))
                                            "subtype"))))))))

(deftest rpc-sessions
  (with-project (project config) '()
    (with-rpc (rpc backend project config :steps '("One." "Two." "Three."))
      (let ((id (new-session rpc))
            (fid nil))
        (call rpc "turn/start" "session_id" id "prompt" "first")
        (rpc-result rpc id)
        (let ((list (event-value (call rpc "session/list") "sessions")))
          (ok (= 1 (length list)))
          (ok (equal id (event-value list 0 "session_id")))
          (ok (eq t (event-value list 0 "open"))))
        (ok (eq t (event-value (call rpc "session/close" "session_id" id) "closed")))
        (ok (eql -32002 (fault rpc "turn/start" "session_id" id "prompt" "x")) "closed")
        (let ((init (call rpc "session/resume" "session_id" (subseq id 0 6))))
          (ok (equal id (event-value init "session_id")))
          (ok (eql 1 (event-value init "turns"))))
        (call rpc "turn/start" "session_id" id "prompt" "second")
        (ok (rpc-result rpc id :n 1))
        (let ((fork (call rpc "session/fork" "session_id" id "at" 1)))
          (setf fid (event-value fork "session_id"))
          (ok (not (equal id fid)))
          (ok (equal id (event-value fork "forked_from")))
          (ok (eql 1 (event-value fork "turns")))
          (call rpc "turn/start" "session_id" fid "prompt" "other")
          (rpc-result rpc fid)
          (ok (equal '("first" "other") (request-user-texts (third (scripted-requests backend))))))
        (multiple-value-bind (code data) (fault rpc "session/resume" "session_id" "ffffffff")
          (ok (eql -32001 code))
          (ok (equal "ffffffff" (event-value data "designator"))))
        (ok (equal fid (event-value (call rpc "session/resume" "last" t) "session_id"))
            "last: the session that committed last (the fork)")))))

(deftest rpc-preview-apply-and-reject
  ;; H5a's plan/approve and plan/reject, renamed preview/apply and preview/reject in 0.15.0.
  (with-project (project config) (list (list "a.txt" (nl "alpha")))
    (with-rpc (rpc backend project config :steps (list (write-tool "a.txt" (nl "beta")) "Done."))
      (let ((id (new-session rpc "permission_mode" "preview")))
        (call rpc "turn/start" "session_id" id "prompt" "beta")
        (let ((result (rpc-result rpc id)))
          (ok (equal "open" (event-value result "preview" "status"))))
        (ok (equal (nl "alpha") (read-file project "a.txt")))
        (let ((applied (call rpc "preview/apply" "session_id" id)))
          (ok (equal "applied" (event-value applied "subtype"))))
        (ok (equal (nl "beta") (read-file project "a.txt")))
        (multiple-value-bind (code data) (fault rpc "preview/reject" "session_id" id)
          (ok (eql -32008 code))
          (ok (equal "plan-not-found" (event-value data "condition"))))))))

(deftest rpc-checkpoints-and-rewind
  (with-project (project config) (list (list "a.txt" (nl "alpha")))
    (with-rpc (rpc backend project config
               :steps (list (write-tool "a.txt" (nl "beta")) "One."
                            (write-tool "a.txt" (nl "gamma")) "Two."))
      (let ((id (new-session rpc "permission_mode" "acceptEdits")))
        (call rpc "turn/start" "session_id" id "prompt" "first")
        (rpc-result rpc id)
        (call rpc "turn/start" "session_id" id "prompt" "second")
        (rpc-result rpc id :n 1)
        (let ((list (event-value (call rpc "checkpoint/list" "session_id" id) "checkpoints")))
          (ok (equal '("turn" "turn" "before") (map 'list (lambda (k) (event-value k "reason")) list))))
        (let ((r (call rpc "rewind" "session_id" id "turn" 1)))
          (ok (equal "rewind" (event-value r "type")))
          (ok (equal "applied" (event-value r "files"))))
        (ok (equal (nl "beta") (read-file project "a.txt")))
        (let ((r (call rpc "rewind" "session_id" id "turn" "0" "mode" "conversation")))
          (ok (equal "skipped" (event-value r "files"))))))))

(deftest rpc-settings-and-tools
  (with-project (project config) '((".cl-stack-code/settings.json"
                                    "{\"env\": {\"API_KEY\": \"s3cr3t\"}}"))
    (with-rpc (rpc backend project config)
      (let* ((id (new-session rpc))
             (s (call rpc "settings/get" "session_id" id))
             (server (call rpc "settings/get"))
             (tools (event-value (call rpc "tools/list" "session_id" id) "tools")))
        (ok (equal "mock" (event-value s "settings" "model")))
        (ok (equalp #("API_KEY") (event-value s "settings" "env")))
        (ok (not (has "s3cr3t" (json:encode s))))
        (ok (equal "mock" (event-value server "settings" "model")) "no session: the server's")
        (ok (equal (append at:+file-tool-names+ at:+shell-tool-names+ at:+unit-tool-names+)
                   (map 'list (lambda (o) (event-value o "name")) tools)))))))

(deftest rpc-configuration-errors
  (with-project (project config) '()
    (with-rpc (rpc backend project config)
      (multiple-value-bind (code data) (fault rpc "session/new" "model" "nope:x")
        (ok (eql -32011 code))
        (ok (equal "nope:x" (event-value data "designator"))))
      (write-file project ".cl-stack-code/settings.json" "{\"maxTurns\": 0}")
      (multiple-value-bind (code data) (fault rpc "session/new")
        (ok (eql -32010 code))
        (ok (equal "maxTurns" (event-value data "key")))
        (ok (has "settings.json" (event-value data "file"))))
      (ok (eql -32602 (fault rpc "session/new" "cwd" "missing/")) "a bad cwd is invalid params"))))

(deftest rpc-eof-interrupts-and-commits
  (with-project (project config) '()
    (let* ((gate (make-gate))
           (backend (make-scripted-backend (list (list :gate gate "Never seen."))))
           (id nil))
      (call-with-rpc project config
                     (lambda (rpc backend thread cell)
                       (declare (ignore backend))
                       (setf id (new-session rpc))
                       (call rpc "turn/start" "session_id" id "prompt" "slow")
                       (ok (wait-until (lambda () (gate-waiting-p gate))))
                       (let ((opener (bt:make-thread (lambda () (sleep 1) (open-gate gate)))))
                         (close-rpc-client rpc)
                         (ok (wait-until (lambda () (not (bt:thread-alive-p thread))) :timeout 30)
                             "the server ends at EOF")
                         (bt:join-thread opener))
                       (ok (eql 0 (car cell)) (format nil "serve-rpc returned ~s" (car cell))))
                     :backend backend)
      (ok (eq :canceled (record-finish (first (session-dir-records project config id))))
          "the running turn was interrupted and committed"))))

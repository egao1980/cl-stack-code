(in-package #:cl-stack-code/tests)

;;; H3d: approvals answered by the caller (src/client.lisp, "Approvals").
;;; The default mode asks for write and edit; an ask pauses the run.

(defun pending-now (session &key (n 1) (timeout 30))
  "Wait until SESSION has N waiting approval requests. → them, or NIL."
  (wait-until (lambda ()
                (let ((p (client-pending-approvals session)))
                  (and (>= (length p) n) p)))
              :timeout timeout))

(deftest client-approval-request-object
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (write-step "a.txt" (nl "hi")) "Wrote it."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "write a.txt"))
             (req (first (pending-now s))))
        (ok req "the run waits")
        (ok (equal "approval_request" (event-type req)))
        (ok (equal '("id" "input" "name" "preview" "session_id" "step" "summary" "type") (jkeys req)))
        (ok (equal "call-1-1" (event-value req "id")))
        (ok (equal "write" (event-value req "name")))
        (ok (eql 1 (event-value req "step")))
        (ok (equal "a.txt" (event-value req "input" "file_path")))
        (ok (equal (tool-call-summary "write" (event-value req "input")) (event-value req "summary")))
        (ok (has "+hi" (event-value req "preview")) "the diff the write would make")
        (ok (member req (events-of events "approval_request")) "delivered as an event too")
        (ok (client-busy-p s) "waiting counts as busy")
        (ok (null (read-file project "a.txt")))
        (client-respond-approval s "call-1-1" :once)
        (client-wait turn :timeout 30)))))

(deftest client-approval-once
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (write-step "a.txt" (nl "hi")) "Wrote it."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "write a.txt")))
        (pending-now s)
        (ok (equal '("call-1-1") (client-respond-approval s "call-1-1" :once)))
        (let ((result (client-wait turn :timeout 30)))
          (ok (equal "success" (event-value result "subtype")))
          (ok (equalp #() (event-value result "permission_denials"))))
        (ok (equal (nl "hi") (read-file project "a.txt")))
        (let ((resolved (first (events-of (code-turn-events turn) "approval_resolved"))))
          (ok (equal "once" (event-value resolved "decision")))
          (ok (equal "call-1-1" (event-value resolved "id"))))
        (ok (equal '("approval_request" "approval_resolved" "tool_result")
                   (remove-if-not (lambda (ty) (member ty '("approval_request" "approval_resolved" "tool_result")
                                                       :test #'string=))
                                  (event-types (code-turn-events turn))))
            "request, answer, then the tool runs")
        (ok (null (read-file project ".cl-stack-code/settings.local.json")) "no rule saved")))))

(deftest client-approval-always-saves-the-rule
  (with-project (project config) (list (list "a.txt" (nl "alpha" "beta")))
    (with-test-client (client backend events project config
                       :steps (list (list :tool "edit" (edit-args "a.txt" "alpha" "ALPHA"))
                                    (list :tool "edit" (edit-args "a.txt" "beta" "BETA"))
                                    "Both done."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "change both")))
        (pending-now s)
        (client-respond-approval s "call-1-1" :always)
        (ok (equal "success" (event-value (client-wait turn :timeout 30) "subtype")))
        (ok (= 1 (length (events-of (code-turn-events turn) "approval_request")))
            "the second edit of a.txt did not ask")
        (ok (equal (nl "ALPHA" "BETA") (read-file project "a.txt")))
        (let ((saved (json:decode (read-file project ".cl-stack-code/settings.local.json"))))
          (ok (equal '("edit(a.txt)") (coerce (jget saved "permissions" "allow") 'list))
              "saved to settings.local.json, as the TUI does"))))))

(deftest client-approval-reject-with-feedback
  (with-project (project config) (list (list "a.txt" (nl "alpha")))
    (with-test-client (client backend events project config
                       :steps (list (list :tool "edit" (edit-args "a.txt" "alpha" "omega"))
                                    "OK, I will not."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "change it")))
        (pending-now s)
        (ok (equal '("call-1-1") (client-respond-approval s "call-1-1" :reject :feedback "use b.txt")))
        (let ((result (client-wait turn :timeout 30)))
          (ok (equal "success" (event-value result "subtype")))
          (ok (equal "rejected" (event-value result "permission_denials" 0 "reason")))
          (ok (equal "call-1-1" (event-value result "permission_denials" 0 "id"))))
        (ok (equal (nl "alpha") (read-file project "a.txt")))
        (let ((tool (first (events-of (code-turn-events turn) "tool_result"))))
          (ok (equal "denied" (event-value tool "status")))
          (ok (has "use b.txt" (event-value tool "content"))))
        (ok (has "use b.txt" (request-text (second (scripted-requests backend)))) "the model sees why")
        (ok (equal "reject" (event-value (first (events-of (code-turn-events turn) "approval_resolved"))
                                         "decision")))))))

(deftest client-approval-reject-all
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (list :tools (list "write" (write-args "a.txt" "1"))
                                          (list "write" (write-args "b.txt" "2")))
                                    "Fine."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "write two")))
        (ok (= 2 (length (pending-now s :n 2))) "two requests, in order")
        (ok (equal '("call-1-1" "call-1-2")
                   (mapcar (lambda (r) (event-value r "id")) (client-pending-approvals s))))
        (ok (equal '("call-1-1" "call-1-2") (client-respond-approval s "call-1-1" :reject-all)))
        (client-wait turn :timeout 30)
        (ok (null (read-file project "a.txt")))
        (ok (null (read-file project "b.txt")))
        (ok (equal '("reject_all" "reject_all")
                   (mapcar (lambda (e) (event-value e "decision"))
                           (events-of (code-turn-events turn) "approval_resolved"))))))))

(deftest client-approval-resumes-after-the-last-answer
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (list :tools (list "write" (write-args "a.txt" "1"))
                                          (list "write" (write-args "b.txt" "2")))
                                    "Both."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "write two")))
        (pending-now s :n 2)
        (ok (equal '("call-1-2") (client-respond-approval s "call-1-2" :once)) "the second first")
        (sleep 0.3)
        (ok (= 1 (length (scripted-requests backend))) "still waiting for the first")
        (ok (equal '("call-1-1") (mapcar (lambda (r) (event-value r "id")) (client-pending-approvals s))))
        (client-respond-approval s "call-1-1" :once)
        (ok (equal "Both." (event-value (client-wait turn :timeout 30) "result")))
        (ok (equal "1" (read-file project "a.txt")))
        (ok (equal "2" (read-file project "b.txt")))))))

(deftest client-approval-callback-answers
  (with-project (project config) '()
    (let ((asked (make-collector)))
      (with-test-client (client backend events project config
                         :steps (list (write-step "a.txt" "yes") (write-step "b.txt" "no") "Done.")
                         :on-approval (lambda (session request)
                                        (declare (ignore session))
                                        (collect asked request)
                                        (if (equal "a.txt" (event-value request "input" "file_path"))
                                            :once
                                            '(:reject "not b"))))
        (let ((result (client-query (client-new-session client) "write" :timeout 30)))
          (ok (equal "success" (event-value result "subtype")))
          (ok (= 2 (length (collected asked))))
          (ok (equal "yes" (read-file project "a.txt")))
          (ok (null (read-file project "b.txt")))
          (ok (has "not b" (request-text (third (scripted-requests backend))))))))))

(deftest client-approval-errors
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (write-step "a.txt" "x") "Done."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "write")))
        (pending-now s)
        (let ((c (failure (client-respond-approval s "nope" :once))))
          (ok (typep c 'approval-not-found))
          (ok (equal "nope" (and c (approval-not-found-id c)))))
        (ok (signals (client-respond-approval s "call-1-1" :maybe) 'code-usage-error))
        (ok (signals (client-steer s "hurry") 'turn-not-running) "waiting is not running")
        (ok (signals (client-turn s "another") 'turn-busy))
        (client-respond-approval s "call-1-1" :once)
        (client-wait turn :timeout 30)
        (ok (signals (client-respond-approval s "call-1-1" :once) 'approval-not-found)
            "answered already")))))

(deftest client-approval-interrupt-denies-and-ends
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (write-step "a.txt" "x") "Never."))
      (let* ((s (client-new-session client))
             (turn (client-turn s "write")))
        (pending-now s)
        (ok (eq t (client-interrupt s)))
        (let ((result (client-wait turn :timeout 30)))
          (ok (equal "error_during_execution" (event-value result "subtype")))
          (ok (has "interrupted" (event-value result "error")))
          (ok (equal "rejected" (event-value result "permission_denials" 0 "reason"))))
        (ok (equal "interrupt" (event-value (first (events-of (code-turn-events turn) "approval_resolved"))
                                            "decision")))
        (ok (= 1 (length (scripted-requests backend))) "the run did not resume")
        (ok (null (client-pending-approvals s)))
        (ok (null (read-file project "a.txt")))))))

(deftest client-approval-bypass-and-deny
  (with-project (project config) '()
    (with-test-client (client backend events project config
                       :steps (list (write-step "a.txt" "x") "One."
                                    (write-step "b.txt" "y") "Two."))
      (let ((bypass (client-new-session client :permission-mode :bypass-permissions)))
        (ok (equal "success" (event-value (client-query bypass "write" :timeout 30) "subtype")))
        (ok (equal "x" (read-file project "a.txt")))
        (ok (null (events-of events "approval_request")) "bypassPermissions asks nothing"))
      (write-file project ".cl-stack-code/settings.json" "{\"permissions\": {\"deny\": [\"write(b.txt)\"]}}")
      (let* ((denied (client-new-session client))
             (result (client-query denied "write b" :timeout 30)))
        (ok (null (events-of events "approval_request")) "a deny rule asks nothing")
        (ok (equal "denied" (event-value result "permission_denials" 0 "reason")))
        (ok (null (read-file project "b.txt")))))))

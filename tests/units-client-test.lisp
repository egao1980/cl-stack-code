(in-package #:cl-stack-code/tests)

;;; H8d SDK: each session's supervisor, CLIENT-UNITS, CLIENT-SUBSCRIBE-UNITS,
;;; CLIENT-READ-UNIT, CLIENT-SEARCH-UNITS, CLIENT-CONTROL-UNIT, and the
;;; permission parity between the agent's unit_control and the caller's.
;;; The fixture turn (UNITS-FIXTURE-STEPS): a foreground echo
;;; (shell-job-1, exited 0), a background sleep (shell-job-2), a background
;;; sort waiting for stdin (shell-job-3), a foreground exit 3 (shell-job-4,
;;; failed 3).

(defparameter +alpha+ "alpha-beta-gamma")

(defun units-fixture-steps (&rest more)
  (append (list (fg (format nil "echo ~a" +alpha+))
                (bg (sleep-command 60))
                (bg +sort-command+)
                (fg "exit 3")
                "Started.")
          more))

(defparameter +fixture-status+ '("exited 0" "running" "running" "failed 3"))

(defun allow-bash (&rest more)
  "A flag layer allowing bash, plus MORE rules (strings; a trailing ! denies)."
  (let ((rules (mapcar (lambda (text)
                         (if (uiop:string-suffix-p text "!")
                             (cons :deny (parse-permission-rule (subseq text 0 (1- (length text))) :deny))
                             (cons :allow (parse-permission-rule text :allow))))
                       (cons "bash" more))))
    (make-settings :allow (mapcar #'cdr (remove :deny rules :key #'car))
                   :deny (mapcar #'cdr (remove :allow rules :key #'car)))))

(defun call-with-units-session (project config fn &key (steps (units-fixture-steps)) rules
                                                       permission-mode)
  "FN gets (client session sup backend events) after the fixture turn ran."
  (with-test-client (client backend events project config
                            :steps steps :settings (apply #'allow-bash rules))
    (let* ((s (apply #'client-new-session client
                     (and permission-mode (list :permission-mode permission-mode))))
           (result (client-query s "start the units" :timeout 60))
           (sup (code-session-supervisor s)))
      (declare (ignore result))
      (funcall fn client s sup backend events))))

(defmacro with-units-session ((client s sup backend events &rest keys) (project config) &body body)
  `(call-with-units-session ,project ,config
                            (lambda (,client ,s ,sup ,backend ,events)
                              (declare (ignorable ,client ,s ,sup ,backend ,events))
                              ,@body)
                            ,@keys))

(defun ids-of (objects) (mapcar (lambda (o) (jget o "id")) objects))

(defun job (sup n) (sup:find-unit sup (format nil "shell-job-~d" n)))

(defun alpha-record (unit)
  (find-if (lambda (r) (search +alpha+ (sup:log-record-text r))) (sup:log-read unit)))

(defun unit-events (events)
  (events-of events "unit"))

(deftest units-client-session-supervisor
  (with-project (project config) '()
    (with-test-client (client backend events project config :steps (units-fixture-steps)
                              :settings (allow-bash))
      (let* ((s (client-new-session client))
             (sup (code-session-supervisor s)))
        (ok (typep sup 'sup:supervisor))
        (ok (same-path (units-directory project :data-dir (data-dir-of config))
                       (sup:supervisor-state-directory sup)))
        (ok (eq sup (at:unit-tools-supervisor (code-session-unit-tools s))))
        (ok (equal at:+unit-tool-names+ (last (coerce (event-value (code-session-init s) "tools") 'list) 5))
            "the init's tools end with the unit tools")
        (client-query s "start the units" :timeout 60)
        (ok (equal '("shell-job-1" "shell-job-2" "shell-job-3" "shell-job-4")
                   (mapcar #'sup:unit-id (sup:find-units sup :kind :shell-job)))
            "every bash command is a unit")
        (let ((s2 (client-new-session client)))
          (ok (not (eq sup (code-session-supervisor s2))) "one supervisor per session")
          (client-close-session s2))
        (client-close-session s)
        (ok (sup:supervisor-closed-p sup) "closing the session shuts it down")
        (ok (eq :killed (sup:unit-state (job sup 2))))))))

(deftest units-client-list
  (with-project (project config) '()
    (with-units-session (client s sup backend events) (project config)
      (let ((objects (client-units s)))
        (ok (equal '("shell-job-1" "shell-job-2" "shell-job-3" "shell-job-4") (ids-of objects)))
        (ok (equal +fixture-status+ (mapcar (lambda (o) (jget o "status")) objects)))
        (ok (every (lambda (o) (same-keys +unit-object-keys+ o)) objects))
        (ok (every (lambda (o) (equal "shell" (jget o "owner"))) objects))
        (ok (equal (ids-of (unit-objects sup)) (ids-of objects)) "UNIT-OBJECTS of the session's supervisor")
        (ok (equal (mapcar (lambda (o) (jget o "pid")) (unit-objects sup))
                   (mapcar (lambda (o) (jget o "pid")) objects))))
      (ok (equal '("shell-job-2" "shell-job-3") (ids-of (client-units s :state "live"))))
      (ok (equal '("shell-job-1" "shell-job-4") (ids-of (client-units s :state "finished"))))
      (ok (equal '("shell-job-4") (ids-of (client-units s :state "failed"))))
      (ok (= 4 (length (client-units s :kind "shell-job"))))
      (ok (null (client-units s :kind "rpc")))
      (ok (= 4 (length (client-units s :owner "sh*"))))
      (ok (typep (failure (client-units s :state "zzz")) 'code-usage-error))
      (let* ((objects (client-units s :resources t))
             (sleeper (find "shell-job-2" objects :key (lambda (o) (jget o "id")) :test #'equal))
             (done (find "shell-job-1" objects :key (lambda (o) (jget o "id")) :test #'equal)))
        (ok (and (integerp (jget sleeper "rss_bytes")) (plusp (jget sleeper "rss_bytes"))))
        (ok (realp (jget sleeper "cpu_time_s")))
        (ok (eq :null (jget done "rss_bytes")) "finished: none")))))

(deftest units-client-read
  (with-project (project config) '()
    (with-units-session (client s sup backend events) (project config)
      (let* ((u (job sup 1))
             (rec (alpha-record u))
             (r (client-read-unit s :unit "shell-job-1")))
        (ok (same-keys '("unit" "status" "records" "gaps" "next_line" "last_line" "ended" "memory") r))
        (ok (equal "shell-job-1" (jget r "unit")))
        (ok (equal "exited 0" (jget r "status")))
        (ok (some (lambda (o) (search +alpha+ (jget o "text"))) (coerce (jget r "records") 'list)))
        (ok (eql (sup:log-last-line u) (jget r "last_line")))
        (ok (eq t (jget r "ended")))
        (ok (eq :null (jget r "memory")))
        (let ((by-ref (client-read-unit s :ref (format nil "shell-job-1:~d:~d" (sup:log-record-segment rec)
                                                       (sup:log-record-line rec)))))
          (ok (find (sup:log-record-line rec) (coerce (jget by-ref "records") 'list)
                    :key (lambda (o) (jget o "line")))
              "a ref reads around its line"))
        (let ((tail (client-read-unit s :unit "shell-job-1" :tail 1)))
          (ok (= 1 (length (jget tail "records")))))
        (ok (zerop (length (jget (client-read-unit s :unit "shell-job-1" :streams '("stderr")) "records")))
            "stream filter"))
      (ok (typep (failure (client-read-unit s :unit "shell-job-9")) 'unit-not-found))
      (ok (typep (failure (client-read-unit s :unit "shell-job-1" :ref "shell-job-1:1:2")) 'code-usage-error))
      (ok (typep (failure (client-read-unit s)) 'code-usage-error))
      (ok (typep (failure (client-read-unit s :unit "shell-job-1" :limit 0)) 'code-usage-error)))))

(deftest units-client-search
  (with-project (project config) '()
    (with-units-session (client s sup backend events) (project config)
      (let* ((rec (alpha-record (job sup 1)))
             (r (client-search-units s +alpha+))
             (hit (first (coerce (jget r "hits") 'list))))
        (ok (same-keys '("hits" "total") r))
        (ok (>= (jget r "total") 1))
        (ok (same-keys '("ref" "unit" "segment" "line" "stream" "time" "kinds" "score" "text" "extent"
                         "excerpt" "gaps")
                       hit))
        (ok (equal "shell-job-1" (jget hit "unit")))
        (ok (eql (sup:log-record-line rec) (jget hit "line")))
        (ok (equal (format nil "shell-job-1:~d:~d" (sup:log-record-segment rec) (sup:log-record-line rec))
                   (jget hit "ref")))
        (ok (equal "stdout" (jget hit "stream")))
        (ok (realp (jget hit "score")))
        (ok (some (lambda (o) (eql (sup:log-record-line rec) (jget o "line")))
                  (coerce (jget hit "excerpt") 'list))))
      (let ((exits (client-search-units s "" :kinds '("exit"))))
        (ok (>= (jget exits "total") 2) "end records of the finished units")
        (ok (eq :null (jget (first (coerce (jget exits "hits") 'list)) "score")) "kinds only: no score"))
      (ok (zerop (jget (client-search-units s +alpha+ :units '("shell-job-2")) "total")) "the units filter")
      (ok (typep (failure (client-search-units s +alpha+ :k 0)) 'code-usage-error))
      (ok (typep (failure (client-search-units s "" )) 'code-usage-error) "an empty query needs kinds"))))

(deftest units-client-subscribe-replay
  (with-project (project config) '()
    (with-units-session (client s sup backend events) (project config)
      (let ((last (sup:supervisor-last-seq sup)))
        (ok (plusp last))
        (multiple-value-bind (id seq complete) (client-subscribe-units s :since 0)
          (ok (equal "sub-1" id))
          (ok (eql last seq))
          (ok (eq t complete))
          (ok (wait-until (lambda () (>= (length (unit-events events)) last))) "the replay")
          (let ((seqs (mapcar (lambda (e) (event-value e "seq")) (unit-events events))))
            (ok (equal (loop for i from 1 to last collect i) (subseq seqs 0 last)) "every event, in order"))
          (ok (every (lambda (e) (and (equal id (event-value e "subscription"))
                                      (equal (code-session-id s) (event-value e "session_id"))))
                     (unit-events events)))
          (client-control-unit s "shell-job-2" "stop" :confirmed t)
          (ok (wait-until (lambda () (find-if (lambda (e) (and (equal "shell-job-2" (event-value e "unit_id"))
                                                               (equal "killed" (event-value e "to"))))
                                              (unit-events events))))
              "then live events")
          (let ((seqs (mapcar (lambda (e) (event-value e "seq")) (unit-events events))))
            (ok (equal seqs (loop for i from 1 to (length seqs) collect i)) "no gap, no duplicate"))
          (multiple-value-bind (id2 seq2) (client-subscribe-units s)
            (ok (equal "sub-2" id2))
            (ok (eql (sup:supervisor-last-seq sup) seq2))
            (sleep 0.5)
            (ok (null (remove id2 (unit-events events) :key (lambda (e) (event-value e "subscription"))
                                                       :test-not #'equal))
                "without since: no replay")
            (ok (eq t (client-unsubscribe-units s id2))))
          (ok (eq t (client-unsubscribe-units s id)))
          (ok (typep (failure (client-unsubscribe-units s id)) 'subscription-not-found)))))))

(deftest units-client-control
  (with-project (project config) '()
    (with-units-session (client s sup backend events) (project config)
      (let ((c (failure (client-control-unit s "shell-job-2" "stop"))))
        (ok (typep c 'unit-control-needs-confirmation) "no rule: the caller must confirm")
        (ok (equal "stop:shell-job-2" (unit-control-needs-confirmation-resource c))))
      (ok (eq :running (sup:unit-state (job sup 2))) "nothing done")
      (let ((r (client-control-unit s "shell-job-2" "stop" :confirmed t)))
        (ok (equal "Stopped shell-job-2: killed" (jget r "result")))
        (ok (equal "killed" (jget r "unit" "status"))))
      (client-control-unit s "shell-job-3" "input" :input (format nil "pear~%apple~%") :confirmed t)
      (client-control-unit s "shell-job-3" "close_input" :confirmed t)
      (ok (wait-state (job sup 3) :exited) "sort got EOF")
      (settle (job sup 3))
      (ok (equal '("apple" "pear")
                 (mapcar (lambda (text) (string-right-trim '(#\Return) text)) (unit-texts (job sup 3)))))
      (ok (typep (failure (client-control-unit s "shell-job-1" "input" :input "x" :confirmed t))
                 'unit-control-failed)
          "input to a finished unit")
      (ok (typep (failure (client-control-unit s "shell-job-1" "kill" :confirmed t)) 'code-usage-error))
      (ok (typep (failure (client-control-unit s "shell-job-9" "stop" :confirmed t)) 'unit-not-found)))))

(deftest units-client-deny-rule
  (with-project (project config) '()
    (with-units-session (client s sup backend events :rules '("unit_control(*:shell-job-3)!"))
        (project config)
      (let ((c (failure (client-control-unit s "shell-job-3" "stop" :confirmed t))))
        (ok (typep c 'unit-control-denied) "confirmed does not beat a deny")
        (ok (equal "unit_control(*:shell-job-3)" (unit-control-denied-rule c))))
      (ok (eq :running (sup:unit-state (job sup 3)))))))

(defun agent-control-outcome (s)
  "Run a turn whose model calls unit_control stop on shell-job-1. → :allow
(the unit was stopped without asking), :ask (an approval request), :deny (a
permission denial)."
  (let ((turn (client-turn s "stop the first job")))
    (wait-until (lambda () (or (code-turn-done-p turn)
                               (events-of (code-turn-events turn) "approval_request")))
                :timeout 60)
    (cond ((events-of (code-turn-events turn) "approval_request")
           (client-interrupt s)
           (client-wait turn :timeout 60)
           :ask)
          ((plusp (length (event-value (code-turn-result turn) "permission_denials"))) :deny)
          (t :allow))))

(defun caller-control-outcome (s)
  (handler-case (progn (client-control-unit s "shell-job-2" "stop") :allow)
    (unit-control-needs-confirmation () :ask)
    (unit-control-denied () :deny)))

(deftest-parametrize units-permission-parity
    ((rules mode expected)
     :ids ("allow-rule" "no-rule" "deny-rule" "bypass")
     ('("unit_control(stop:shell-job-*)") nil :allow)
     ('() nil :ask)
     ('("unit_control(stop:shell-job-*)!") nil :deny)
     ('() :bypass-permissions :allow))
  (with-project (project config) '()
    (with-units-session (client s sup backend events
                                :steps (list (bg (sleep-command 60)) (bg (sleep-command 60)) "Started."
                                             (list :tool "unit_control"
                                                   (json-args "unit" "shell-job-1" "action" "stop"))
                                             "Done.")
                                :rules rules :permission-mode mode)
        (project config)
      (let ((agent (agent-control-outcome s))
            (caller (caller-control-outcome s)))
        (ok (eq expected agent) "the agent's unit_control")
        (ok (eq expected caller) "the caller's control")
        (ok (eq agent caller) "one permission layer")))))

(in-package #:cl-stack-code/tests)

;;; H4b headless: -p with a spawned or attached image (real ros +Q run
;;; images with Swank) and the scripted mock LLM.

(defun image-stream-run (project config argv steps)
  "CODE with --output-format stream-json. → (values exit out err backend)."
  (code project config (append '("-p" "--output-format" "stream-json") argv) :steps steps))

(deftest lisp-image-cli-spawn
  (with-project (project config) '(("AGENTS.md" "Project rule."))
    (multiple-value-bind (exit out err backend)
        (image-stream-run project config '("--lisp-image" "spawn" "--allowed-tools" "repl-eval" "add")
                    (list (list :tool "repl-eval" (json-args "code" "(+ 1 2)")) "Three."))
      (ok (= 0 exit) err)
      (let ((init (first (events out "system"))))
        (ok (equal "spawn" (jget init "lisp_image" "kind")))
        (ok (equal "image" (jget init "lisp_image" "name")))
        (ok (equal "swank" (jget init "lisp_image" "backend")))
        (ok (eq :null (jget init "lisp_image" "port")))
        (ok (null (jget init "lisp_image" "observe")))
        (let ((tools (coerce (jget init "tools") 'list)))
          (ok (member "repl-eval" tools :test #'string=))
          (ok (> (position "repl-eval" tools :test #'string=)
                 (position "bash" tools :test #'string=))
              "after the file and shell tools")))
      (ok (has "=> 3" (jget (tool-result-named out "repl-eval") "content")))
      (let ((system (request-system (first (scripted-requests backend)))))
        (ok (has "# Lisp image" system))
        (ok (has "- Image: image (spawned, swank)" system))
        (ok (has "IMAGE EVENTS:" system) "lisp-mcp/agent's instructions"))
      (ok (equal "success" (jget (car (last (json-lines out))) "subtype"))))))

(deftest lisp-image-cli-no-image
  (with-project (project config) '()
    (multiple-value-bind (exit out) (image-stream-run project config '("hi") (list "Hello."))
      (ok (= 0 exit))
      (let ((init (first (events out "system"))))
        (ok (not (member "lisp_image" (jkeys init) :test #'string=)) "the init shape is H3a's")
        (ok (not (member "repl-eval" (coerce (jget init "tools") 'list) :test #'string=)))))))

(deftest lisp-image-cli-background-debugger
  (with-project (project config) '()
    (multiple-value-bind (exit out err backend)
        (image-stream-run project config
                    '("--lisp-image" "spawn"
                      "--allowed-tools" "repl-eval" "--allowed-tools" "debug-invoke-restart(restart:retry-later)"
                      "watch it")
                    (list (list :tool "repl-eval" (json-args "code" +bg-error+))
                          (list :tool "debug-invoke-restart" (json-args "restart" 1))
                          (list :tool "debug-invoke-restart" (json-args "restart" 0))
                          "Fixed."))
      (ok (= 0 exit) err)
      (let ((requests (scripted-requests backend)))
        (ok (= 4 (length requests)))
        (ok (null (request-image-turns (first requests))))
        (ok (= 1 (length (request-image-turns (second requests))))
            "the event is in the inbox before the next generate")
        (ok (has "bg boom" (turn-text* (first (request-image-turns (second requests)))))))
      (let ((event (first (events out "image_event"))))
        (ok event "a stream-json image_event line")
        (ok (equal "debugger" (jget event "kind")))
        (ok (equal "image" (jget event "connection")))
        (ok (eql 1 (jget event "level")))
        (ok (eq :null (jget event "job")))
        (ok (uiop:string-prefix-p +image-tag+ (jget event "text"))))
      (let ((abort (tool-result-named out "debug-invoke-restart" 0))
            (retry (tool-result-named out "debug-invoke-restart" 1))
            (result (car (last (json-lines out)))))
        (ok (equal "denied" (jget abort "status")) "no rule allows restart:abort: -p denies the ask")
        (ok (equal "headless" (jget result "permission_denials" 0 "reason")))
        (ok (equal "done" (jget retry "status")))
        (ok (has "Invoked restart 0 [RETRY-LATER]" (jget retry "content")))
        (ok (equal "success" (jget result "subtype")))))))

(deftest lisp-image-cli-tool-call-debugger
  (with-project (project config) '()
    (multiple-value-bind (exit out err)
        (image-stream-run project config
                    '("--lisp-image" "spawn" "--allowed-tools" "repl-eval"
                      "--allowed-tools" "debug-invoke-restart(restart:return-default)" "fix it")
                    (list (list :tool "repl-eval" (json-args "code" +seeded-bug+))
                          (list :tool "repl-eval" (json-args "code" "(seeded 1)"))
                          (list :tool "debug-invoke-restart" (json-args "restart" 0))
                          "Fixed."))
      (ok (= 0 exit) err)
      (ok (has "DEBUGGER level 1" (jget (tool-result-named out "repl-eval" 1) "content"))
          "the call returns the debugger state")
      (ok (null (events out "image_event")) "a tool call's debugger is not an image event")
      (ok (has "=> 42" (jget (tool-result-named out "debug-invoke-restart") "content"))))))

(deftest lisp-image-cli-observe-is-a-hard-gate
  (with-swank-server (port server)
    (with-project (project config) '()
      (multiple-value-bind (exit out err)
          (image-stream-run project config
                      (list "--lisp-image" (format nil "attach:~d" port) "--lisp-observe"
                            "--permission-mode" "bypassPermissions" "poke it")
                      (list (list :tool "repl-eval" (json-args "code" "(+ 1 2)"))
                            (list :tool "repl-eval" (json-args "code" "(defparameter *poked* 1)"))
                            "Done."))
        (ok (= 0 exit) err)
        (let ((init (first (events out "system"))))
          (ok (equal "attach" (jget init "lisp_image" "kind")))
          (ok (equal "127.0.0.1" (jget init "lisp_image" "host")))
          (ok (eql port (jget init "lisp_image" "port")))
          (ok (eq t (jget init "lisp_image" "observe"))))
        (ok (has "=> 3" (jget (tool-result-named out "repl-eval" 0) "content")) "pure code runs")
        (let ((poke (tool-result-named out "repl-eval" 1)))
          (ok (eq t (jget poke "is_error")) "bypassPermissions does not lift observe mode")
          (ok (has "observe" (jget poke "content"))))
        (ok (not (member "debug-invoke-restart" (coerce (jget (first (events out "system")) "tools") 'list)
                         :test #'string=))
            "an observer is not offered restarts"))
      (ok (has "=> NIL" (server-eval server "(boundp '*poked*)")) "the image never saw the form")
      (ok (has "=> 3" (server-eval server "(+ 1 2)")) "the attached image keeps running"))))

(deftest lisp-image-cli-attach-failure
  (with-project (project config) '()
    (multiple-value-bind (exit out err backend)
        (code project config '("-p" "--lisp-image" "attach:127.0.0.1:1" "hi") :steps (list "Hello."))
      (ok (= 1 exit))
      (ok (equal "" out))
      (ok (has "cl-stack-code: cannot attach to the Lisp image at 127.0.0.1:1" err))
      (ok (null (scripted-requests backend)) "no model call"))))

(deftest-parametrize lisp-image-cli-usage-errors
    ((argv needle)
     :ids ("observe-spawn" "observe-alone" "plan-mode")
     ('("--lisp-image" "spawn" "--lisp-observe") "--lisp-observe needs --lisp-image attach")
     ('("--lisp-observe") "--lisp-observe needs --lisp-image attach")
     ('("--lisp-image" "spawn" "--permission-mode" "plan") "not available in plan mode"))
  (with-project (project config) '()
    (multiple-value-bind (exit out err backend)
        (code project config (append '("-p") argv '("hi")) :steps (list "Hello."))
      (ok (= 2 exit))
      (ok (equal "" out))
      (ok (has needle err))
      (ok (null (scripted-requests backend))))))

(deftest lisp-image-cli-settings-file
  (with-project (project config) '()
    (write-file project ".cl-stack-code/settings.json" (lisp-settings "image" "spawn"))
    (multiple-value-bind (exit out err)
        (image-stream-run project config '("--allowed-tools" "repl-eval" "add")
                    (list (list :tool "repl-eval" (json-args "code" "(* 6 7)")) "42."))
      (ok (= 0 exit) err)
      (ok (equal "spawn" (jget (first (events out "system")) "lisp_image" "kind")))
      (ok (has "=> 42" (jget (tool-result-named out "repl-eval") "content"))))
    (multiple-value-bind (exit out)
        (image-stream-run project config '("--lisp-image" "off" "hi") (list "Hello."))
      (ok (= 0 exit))
      (ok (not (member "lisp_image" (jkeys (first (events out "system"))) :test #'string=))
          "--lisp-image off overrides the project file"))))

(in-package #:cl-stack-code/tests)

;;; H8d interactive: the unit panel on tui-backend-terminal's headless driver
;;; (120 × 30). The fixture session: two background shell jobs the agent
;;; started with bash, a fake stdio server (:rpc) and a subagent thread in
;;; scope "sub" (WITH-UNITS-TUI). Rows are compared with the UP, CPU% and RSS
;;; columns masked (they move with the clock and the load).

(defun header-row* ()
  (string-right-trim " " (format nil "~a~20a ~9a ~9a ~6@a ~6@a ~5@a ~6@a  ~a" "  "
                                 "UNIT" "STATE" "KIND" "PID" "UP" "CPU%" "RSS" "LAST")))

(defun open-panel (tui)
  (press-panel-key tui)
  (wait-screen tui "Units · "))

(defun wait-unit-row (tui id needle)
  "True once the panel row of unit ID contains NEEDLE."
  (wait-for* tui (lambda () (let ((row (unit-screen-row tui id))) (and row (search needle row))))))

(defun selected-id (tui)
  "The id on the panel row marked \"> \", or NIL."
  (let ((row (find-if (lambda (r) (uiop:string-prefix-p "> " r)) (screen tui))))
    (and row (>= (length row) 22) (string-trim " " (subseq row 2 22)))))

(defun select-unit (tui id)
  "Press Down until ID is selected (at most 10 times), waiting after each press
for the selection to move (the screen redraws asynchronously). → true when it is."
  (loop repeat 10
        for before = (selected-id tui)
        until (equal id before)
        do (h:tui-press tui :arrow-down)
           (wait-for* tui (lambda ()
                            (let ((now (selected-id tui)))
                              (and now (not (equal now before)))))
                      :timeout 2))
  (equal id (selected-id tui)))

(deftest units-panel-snapshot
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key jobs server sub) (fixture-units sup)
        (ok (= 2 (length jobs)) "the agent's bash jobs are units of the program's supervisor")
        (ok (every (lambda (j) (equal '("shell") (sup:scope-path (sup:unit-owner j)))) jobs))
        (ok (wait-text sub "sub: working on needle-42"))
        (ok (open-panel tui))
        (ok (panel-open-p program))
        (ok (wait-for* tui (lambda () (search "sub: working on needle-42" (screen-text tui)))))
        (let ((rows (screen tui)))
          (ok (equal "Units · 4 running · 4 total" (first rows)))
          (ok (equal (header-row*) (second rows)))
          (ok (equal (unit-row* server 0 :selected t) (masked (third rows))) "rpc-1 (root), selected")
          (ok (equal (scope-row* "shell" 0) (fourth rows)))
          (ok (equal (unit-row* (first jobs) 1) (masked (fifth rows))))
          (ok (equal (unit-row* (second jobs) 1) (masked (sixth rows))))
          (ok (equal (scope-row* "sub" 0) (seventh rows)))
          (ok (equal (unit-row* sub 1 :last "sub: working on needle-42") (masked (eighth rows))))
          (ok (equal +unit-list-help+ (nth 28 rows)) "the help row above the status line")
          (ok (rule-row-p (nth 27 rows)))
          (ok (not (search "Started." (screen-text tui))) "the panel replaces the transcript"))
        (ok (search "4 running · " (last-row tui)) "the status line count")
        (ok (cell-inverse-p tui 4 2) "the selected row is inverse")
        (ok (not (cell-inverse-p tui 4 4)))
        (h:tui-press tui :escape)
        (ok (wait-gone tui "Units · "))
        (ok (not (panel-open-p program)))
        (ok (wait-screen tui "Started.") "the transcript is back")))))

(deftest units-panel-open-close
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (send-line tui "/ps")
      (ok (wait-screen tui "Units · ") "/ps opens it")
      (h:tui-type tui "q")
      (ok (wait-gone tui "Units · ") "q closes it")
      (h:tui-type tui "draft text")
      (ok (wait-screen tui "> draft text"))
      (press-panel-key tui)
      (ok (wait-screen tui "Units · ") "Ctrl-P opens it")
      (ok (not (on-screen tui "> draft text")) "the input is hidden")
      (h:tui-type tui "x")
      (press-panel-key tui)
      (ok (wait-gone tui "Units · ") "Ctrl-P closes it")
      (ok (wait-screen tui "> draft text") "the input kept its text; keys went to the panel"))))

(deftest units-panel-live-update
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key jobs &allow-other-keys) (fixture-units sup)
        (ok (open-panel tui))
        (ok (wait-screen tui "Units · 4 running · 4 total"))
        (sup:stop-unit (second jobs) :grace 2)
        (ok (wait-unit-row tui "shell-job-2" "killed") "a state change shows at once")
        (ok (wait-screen tui "Units · 3 running · 4 total"))
        (ok (wait-for* tui (lambda () (search "3 running · " (last-row tui)))))
        (let ((new (sup:start-unit sup :rpc :command (echo-argv))))
          (ok (wait-for* tui (lambda () (unit-screen-row tui (sup:unit-id new)))) "a new unit appears")
          (ok (wait-screen tui "Units · 4 running · 5 total")))
        (ok (wait-for* tui (lambda ()
                             (let ((row (unit-screen-row tui "shell-job-1")))
                               (and row (not (string= "-" (string-trim " " (subseq row 50 56))))))))
            "a live unit shows its uptime")))))

(deftest units-failure-notice-in-transcript
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key jobs &allow-other-keys) (fixture-units sup)
        (sup:start-unit sup :shell-job :command (exit-argv 3))
        (ok (wait-screen tui "unit shell-job-3 (shell-job) failed with exit code 3; /ps to inspect"))
        (sup:stop-unit (first jobs) :grace 2)
        (ok (wait-for* tui (lambda () (search "3 running · " (last-row tui)))))
        (ok (not (on-screen tui "unit shell-job-1 (shell-job) failed")) "a stop is not a failure")))))

(deftest units-panel-follow-and-search
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key sub &allow-other-keys) (fixture-units sup)
        (ok (wait-text sub "sub: working on needle-42"))
        (ok (open-panel tui))
        (ok (select-unit tui "subagent-1"))
        (h:tui-press tui :enter)
        (ok (wait-screen tui "Log subagent-1 (running) · following"))
        (ok (eq :log (unit-panel-mode (code-program-panel program))))
        (let ((started (record-of sub "sub: started"))
              (working (record-of sub "sub: working on needle-42")))
          (ok (wait-screen tui (log-line* " " (sup:log-record-line started) "sub: started")))
          (ok (on-screen tui (log-line* " " (sup:log-record-line working) "sub: working on needle-42")))
          (ok (on-screen tui +unit-log-help+))
          (h:tui-type tui "/")
          (ok (wait-screen tui "search> "))
          (h:tui-type tui "needle-42")
          (h:tui-press tui :enter)
          (ok (wait-screen tui "search \"needle-42\": 1 of 1"))
          (let* ((hit (log-line* ">" (sup:log-record-line working) "sub: working on needle-42"))
                 (y (row-index tui hit)))
            (ok y "the hit line is marked")
            (when y
              (let ((x (search "needle-42" (nth y (screen tui)))))
                (ok (cell-inverse-p tui x y) "the term is highlighted")
                (ok (cell-inverse-p tui (+ x 8) y))
                (ok (not (cell-inverse-p tui (- x 2) y)) "the rest of the line is not"))))
          (ok (= 1 (length (unit-panel-hits (code-program-panel program)))))
          (h:tui-type tui "n")
          (ok (wait-screen tui "search \"needle-42\": 1 of 1") "n wraps")
          (setf (car gate) t)
          (h:tui-press tui :end)
          (ok (wait-screen tui "sub: done") "new lines arrive while following")
          (ok (wait-screen tui "Log subagent-1 (exited)"))
          (h:tui-press tui :escape)
          (ok (wait-gone tui "search \"needle-42\"") "Esc clears the search first")
          (h:tui-press tui :escape)
          (ok (wait-screen tui "Units · ") "then goes back to the list")
          (ok (eq :list (unit-panel-mode (code-program-panel program)))))))))

(deftest units-panel-stop-through-dialog
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key jobs &allow-other-keys) (fixture-units sup)
        (ok (open-panel tui))
        (ok (select-unit tui "shell-job-1"))
        (h:tui-type tui "s")
        (ok (wait-screen tui "Unit control") "no rule: the dialog asks")
        (ok (on-screen tui "stop shell-job-1 (shell-job, running): "))
        (ok (on-screen tui "Yes"))
        (ok (eq :running (sup:unit-state (first jobs))) "nothing happens before the answer")
        (h:tui-press tui :enter)
        (ok (wait-screen tui "Stopped shell-job-1: killed") "the unit tool's text")
        (ok (wait-state (first jobs) :killed))
        (ok (wait-unit-row tui "shell-job-1" "killed"))
        (ok (select-unit tui "shell-job-2"))
        (h:tui-type tui "s")
        (ok (wait-screen tui "Unit control"))
        (h:tui-press tui :arrow-down)
        (h:tui-press tui :enter)
        (ok (wait-gone tui "Unit control") "No")
        (sleep 0.5)
        (ok (eq :running (sup:unit-state (second jobs))) "No leaves it running")
        (h:tui-type tui "s")
        (ok (wait-screen tui "Unit control"))
        (h:tui-press tui :escape)
        (ok (wait-gone tui "Unit control") "Esc is No")
        (ok (eq :running (sup:unit-state (second jobs))))
        (h:tui-press tui :escape)
        (ok (wait-gone tui "Units · "))
        (ok (wait-screen tui "unit_control: Stopped shell-job-1: killed") "the transcript notice")))))

(deftest units-panel-stop-through-allow-rule
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate
                         :argv '("--allowed-tools" "unit_control(stop:shell-job-*)"))
        (project config)
      (destructuring-bind (&key jobs &allow-other-keys) (fixture-units sup)
        (ok (open-panel tui))
        (ok (select-unit tui "shell-job-1"))
        (h:tui-type tui "s")
        (ok (wait-screen tui "Stopped shell-job-1: killed") "the rule allows it: no dialog")
        (ok (not (on-screen tui "Unit control")))
        (ok (wait-state (first jobs) :killed))
        (ok (select-unit tui "shell-job-2"))
        (h:tui-type tui "r")
        (ok (wait-screen tui "Unit control") "a restart still asks")
        (ok (on-screen tui "restart shell-job-2 (shell-job, running)"))
        (h:tui-press tui :escape)
        (ok (wait-gone tui "Unit control"))))))

(deftest units-panel-deny-rule
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate
                         :argv '("--disallowed-tools" "unit_control(*:rpc-*)"))
        (project config)
      (destructuring-bind (&key server &allow-other-keys) (fixture-units sup)
        (ok (open-panel tui))
        (ok (equal "rpc-1" (selected-id tui)))
        (h:tui-type tui "s")
        (ok (wait-screen tui "stop rpc-1 denied by unit_control(*:rpc-*)"))
        (ok (not (on-screen tui "Unit control")) "no dialog")
        (sleep 0.5)
        (ok (eq :running (sup:unit-state server)))
        (press-panel-key tui)
        (ok (wait-screen tui "error: stop rpc-1 denied by unit_control(*:rpc-*)") "a transcript error")))))

(deftest units-panel-input-and-close-input
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key server &allow-other-keys) (fixture-units sup)
        (ok (open-panel tui))
        (ok (equal "rpc-1" (selected-id tui)))
        (h:tui-press tui :enter)
        (ok (wait-screen tui "Log rpc-1 (running) · following"))
        (h:tui-type tui "i")
        (ok (wait-screen tui "input> "))
        (h:tui-type tui "ping")
        (h:tui-press tui :enter)
        (ok (wait-screen tui "Unit control"))
        (ok (on-screen tui "input: ping⏎"))
        (h:tui-press tui :enter)
        (ok (wait-screen tui "Sent 5 characters to rpc-1"))
        (ok (wait-text server "ping") "the server got the line")
        (ok (wait-screen tui (log-line* " " (sup:log-record-line (record-of server "ping")) "ping"))
            "and its answer shows in the followed log")
        (h:tui-type tui "e")
        (ok (wait-screen tui "close input rpc-1 (rpc, running)"))
        (h:tui-press tui :enter)
        (ok (wait-screen tui "then closed its stdin"))
        (ok (wait-state server :exited) "EOF ends the echo server")
        (ok (wait-screen tui "Log rpc-1 (exited 0)"))))))

(deftest units-panel-matches-unit-objects
  (with-project (project config) '()
    (with-units-tui (tui program backend sup gate) (project config)
      (destructuring-bind (&key sub &allow-other-keys) (fixture-units sup)
        (ok (wait-text sub "sub: working on needle-42"))
        (ok (open-panel tui))
        (let ((objects (unit-objects sup)))
          (ok (= 4 (length objects)))
          (ok (equal (mapcar (lambda (o) (jget o "id")) objects)
                     (loop for row in (screen tui)
                           for id = (and (>= (length row) 22) (string-trim " " (subseq row 2 22)))
                           when (find id objects :key (lambda (o) (jget o "id")) :test #'equal)
                             collect id))
              "the same units in the same order")
          (dolist (o objects)
            (let ((row (unit-screen-row tui (jget o "id"))))
              (ok (and row (string= (jget o "status") (string-trim " " (subseq row 23 32))))
                  (jget o "id"))
              (ok (and row (string= (jget o "kind") (string-trim " " (subseq row 33 42)))))
              (ok (and row (string= (if (eq :null (jget o "pid")) "-" (princ-to-string (jget o "pid")))
                                    (string-trim " " (subseq row 43 49)))))))
          (ok (on-screen tui (format nil "Units · ~d running"
                                     (count-if (lambda (o) (member (jget o "state") '("running" "starting")
                                                                   :test #'string=))
                                               objects)))))))))

(deftest units-program-wiring-and-close
  (with-project (project config) '()
    (let ((sup nil) (jobs nil))
      (with-code-tui (tui program backend :argv '("--allowed-tools" "bash")
                                          :steps (two-jobs-steps) :cols 120 :rows 30)
          (project config)
        (setf sup (code-program-supervisor program))
        (ok (typep sup 'sup:supervisor))
        (ok (same-path (units-directory project :data-dir (data-dir-of config))
                       (sup:supervisor-state-directory sup)))
        (ok (eq sup (at:unit-tools-supervisor (code-program-unit-tools program))))
        (send-line tui "start the jobs")
        (ok (wait-screen tui "Started."))
        (setf jobs (sup:find-units sup :kind :shell-job))
        (ok (= 2 (length jobs)))
        (ok (every (lambda (name)
                     (member name (request-tool-names (first (scripted-requests backend))) :test #'string=))
                   at:+unit-tool-names+)
            "the agent is offered the unit tools")
        (ok (wait-for* tui (lambda () (search "2 running · " (last-row tui))))))
      (ok (sup:supervisor-closed-p sup) "closing the program shuts its supervisor down")
      (ok (every (lambda (j) (eq :killed (sup:unit-state j))) jobs) "its units are stopped"))))

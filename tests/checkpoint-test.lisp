(in-package #:cl-stack-code/tests)

;;; H5b: checkpoints and rewind at the API level (src/checkpoints.lisp
;;; header), over plain folders, git repositories and jj repositories.

;;; Kinds.

(defun checkpoint-kind-auto-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha"))
    (ok (eq kind (resolve-checkpoint-kind project)))
    (with-checkpointer (cp project config)
      (ok (checkpointer-p cp))
      (ok (eq kind (checkpointer-kind cp)))
      (ok (same-path project (checkpointer-project-dir cp)))
      (ok (eql +default-checkpoint-keep+ (checkpointer-keep cp)))
      (ok (checkpointer-enabled-p cp)))))

(deftest-parametrize checkpoint-kind-auto
    ((kind) :ids ("copy" "git" "jj") (:copy) (:git) (:jj))
  (checkpoint-kind-auto-case kind))

(deftest checkpoint-kind-explicit
  (with-project (project config) '(("a.txt" "alpha"))
    (ok (eq :copy (resolve-checkpoint-kind project :kind :copy)))
    (let ((c (failure (resolve-checkpoint-kind project :kind :git))))
      (ok (typep c 'checkpoint-error))
      (ok (has "checkpoints.kind git: " (princ-to-string c)))
      (ok (has "is not a git worktree" (princ-to-string c))))
    (let ((c (failure (resolve-checkpoint-kind project :kind :jj))))
      (ok (typep c 'checkpoint-error))
      (ok (has "checkpoints.kind jj: " (princ-to-string c)))
      (ok (has "is not a jj workspace" (princ-to-string c))))
    (ok (typep (failure (make-checkpointer project :kind :git :data-dir (data-dir-of config)))
               'checkpoint-error)
        "the kind is resolved when the checkpointer is made"))
  (with-git-project (project config) '(("a.txt" "alpha"))
    (ok (eq :copy (resolve-checkpoint-kind project :kind :copy)) "copy always works")
    (ok (eq :git (resolve-checkpoint-kind project :kind :git)))))

;;; Turns.

(defun checkpoint-unchanged-turn-records-nothing-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (ok (files-state-p (begin-checkpoint-turn cp s)))
        (ok (null (edit-turn cp s "look")))
        (ok (null (session-checkpoints s)))
        (ok (null (tip-checkpoint s)))))))

(deftest-parametrize checkpoint-unchanged-turn-records-nothing
    ((kind) :ids ("copy" "git" "jj") (:copy) (:git) (:jj))
  (checkpoint-unchanged-turn-records-nothing-case kind))

(defun checkpoint-first-change-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha
"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (multiple-value-bind (recorded turn)
            (edit-turn cp s "make it beta" (list "a.txt" (nl "beta")) (list "b.txt" (nl "new")))
          (ok (equal '(:before :turn) (reasons recorded)))
          (destructuring-bind (before after) recorded
            (ok (equal '(1 2) (mapcar #'checkpoint-ordinal recorded)))
            (ok (= 0 (checkpoint-turn before)))
            (ok (null (checkpoint-turn-id before)) "turn 1 has no parent")
            (ok (equal "session start" (checkpoint-message before)))
            (ok (= 1 (checkpoint-turn after)))
            (ok (equal (rev:revision-id turn) (checkpoint-turn-id after)))
            (ok (equal "make it beta" (checkpoint-message after)))
            (ok (every (lambda (k) (eq kind (checkpoint-files-kind k))) recorded))
            (ok (every (lambda (k) (= 40 (length (checkpoint-id k)))) recorded))
            (ok (notany #'checkpoint-expired-p recorded))
            (ok (equal (nl "alpha") (checkpoint-file before s project "a.txt")))
            (ok (null (checkpoint-file before s project "b.txt")))
            (ok (equal (nl "beta") (checkpoint-file after s project "a.txt")))
            (ok (equal (nl "new") (checkpoint-file after s project "b.txt")))
            (ok (equal (ids recorded) (ids (session-checkpoints s))))
            (ok (equal (checkpoint-id after) (checkpoint-id (tip-checkpoint s))))))))))

(deftest-parametrize checkpoint-first-change
    ((kind) :ids ("copy" "git" "jj") (:copy) (:git) (:jj))
  (checkpoint-first-change-case kind))

(deftest checkpoint-later-turns
  (with-project (project config) '(("a.txt" "v0"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (edit-turn cp s "one" '("a.txt" "v1"))
        (multiple-value-bind (recorded t2) (edit-turn cp s "two" '("a.txt" "v2"))
          (ok (equal '(:turn) (reasons recorded)) "the files were the tip's when turn 2 started")
          (write-file project "u.txt" "mine")
          (multiple-value-bind (recorded3 t3) (edit-turn cp s "three" '("a.txt" "v3"))
            (ok (equal '(:before :turn) (reasons recorded3)) "the user's edit since the tip")
            (destructuring-bind (before after) recorded3
              (ok (equal (rev:revision-id t2) (checkpoint-turn-id before)) "it belongs to turn 2")
              (ok (= 2 (checkpoint-turn before)))
              (ok (equal "v2" (checkpoint-file before s project "a.txt")))
              (ok (equal "mine" (checkpoint-file before s project "u.txt")))
              (ok (equal (rev:revision-id t3) (checkpoint-turn-id after)))
              (ok (equal '(1 2 3 4 5) (mapcar #'checkpoint-ordinal (session-checkpoints s)))))))
        (write-file project "a.txt" "v3 by hand")
        (ok (null (edit-turn cp s "four")) "user edits alone are not recorded")
        (edit-turn cp s "five" '("a.txt" "v3"))
        (ok (= 5 (length (session-checkpoints s)))
            "a turn that leaves the tip's files records nothing")))))

(deftest checkpoint-copy-files-are-snapshots
  (with-project (project config) '(("a.txt" "alpha") ("d/b.txt" "bravo"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (after (second (edit-turn cp s "go" '("a.txt" "beta")))))
        (ok (eql 0 (search "sha256:" (checkpoint-files-id after))))
        (ok (equal (p:snapshot (native project) :ignore :auto :store (p:make-memory-snapshot-store))
                   (checkpoint-files-id after))
            "the id is the project's pathlib snapshot id (:ignore :auto)")
        (ok (equal '("a.txt" "d/b.txt")
                   (mapcar #'p:snapshot-entry-path
                           (p:snapshot-entries (checkpoint-files-id after) :store (blob-store s))))
            "stored in <checkpoints>/store/, .git/ left out")))))

(deftest checkpoint-git-commits-on-private-refs
  (with-git-project (project config) '(("a.txt" "alpha
"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (head (head-of project))
             (pre (begin-checkpoint-turn cp s)))
        (write-file project "a.txt" (nl "beta"))
        (write-file project "u.txt" (nl "untracked"))
        (let* ((status (git project "status" "--porcelain"))
               (index (index-hash project))
               (turn (commit s "go"))
               (recorded (end-checkpoint-turn cp s pre turn)))
          (destructuring-bind (before after) recorded
            (dolist (k recorded)
              (ok (= 40 (length (checkpoint-files-id k))))
              (ok (equal "commit" (trim (git project "cat-file" "-t" (checkpoint-files-id k))))))
            (ok (equal (list head) (parents-of project (checkpoint-files-id before))) "parent = HEAD")
            (ok (equal (list head) (parents-of project (checkpoint-files-id after))))
            (ok (equal (checkpoint-files-id before)
                       (trim (git project "rev-parse" (checkpoint-ref-name s 1)))))
            (ok (equal (checkpoint-files-id after)
                       (trim (git project "rev-parse" (checkpoint-ref-name s 2)))))
            (ok (equal (format nil "cl-stack-code checkpoint ~a 2" (session-id s))
                       (trim (git project "log" "-1" "--format=%B" (checkpoint-files-id after)))))
            (ok (equal (nl "alpha") (checkpoint-file before s project "a.txt")))
            (ok (equal (nl "beta") (checkpoint-file after s project "a.txt")))
            (ok (equal (nl "untracked") (checkpoint-file after s project "u.txt"))
                "untracked files are recorded"))
          (ok (equal head (head-of project)) "HEAD stays")
          (ok (equal "main" (trim (git project "symbolic-ref" "--short" "HEAD"))))
          (ok (equal index (index-hash project)) "the index stays")
          (ok (equal status (git project "status" "--porcelain")) "the working tree stays"))))))

(deftest checkpoint-jj-commits-are-working-copy-snapshots
  (with-jj-project (project config) '(("a.txt" "alpha
"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (change (trim (jj project "log" "--no-graph" "-r" "@" "-T" "change_id")))
             (after (second (edit-turn cp s "go" (list "a.txt" (nl "beta"))))))
        (ok (= 40 (length (checkpoint-files-id after))))
        (ok (equal (nl "beta") (checkpoint-file after s project "a.txt")))
        (ok (equal change (trim (jj project "log" "--no-graph" "-r" "@" "-T" "change_id")))
            "@ is still the same change")
        (ok (equal "" (trim (jj project "bookmark" "list"))) "no bookmark")
        (ok (equal (nl "beta") (read-file project "a.txt")) "the files stay")))))

;;; The composite revision.

(defun checkpoint-is-a-composite-revision-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (recorded (edit-turn cp s "go" '("a.txt" "beta")))
             (before (first recorded))
             (after (second recorded))
             (cs (checkpoint-store s)))
        (ok (checkpoint-store-p cs))
        (ok (eq cs (checkpoint-store s)) "one per session store object")
        (ok (eq s (checkpoint-store-session cs)))
        (let ((m (rev:composite-manifest cs (checkpoint-id after))))
          (ok m)
          (ok (equal '(:files :conversation) (mapcar #'rev:part-role (rev:manifest-parts m))))
          (destructuring-bind (files conversation) (rev:manifest-parts m)
            (ok (equal (checkpoint-files-id after) (rev:part-revision-id files)))
            (ok (equal (checkpoint-turn-id after) (rev:part-revision-id conversation)))
            (ok (eq s (rev:part-store conversation)))
            (ok (equal '(:files) (rev:part-depends-on conversation)))
            (if (eq kind :git)
                (progn
                  (ok (git:git-store-p (rev:part-store files)) "V3: the files part lives in the git store")
                  (ok (equal (checkpoint-files-id after)
                             (rev:revision-id (rev:resolve-revision (rev:part-store files)
                                                                    (checkpoint-files-id after))))))
                (ok (null (rev:part-store files)) "a pathlib snapshot is not a revision store"))))
        (ok (equal '(:files)
                   (mapcar #'rev:part-role
                           (rev:manifest-parts (rev:composite-manifest cs (checkpoint-id before)))))
            "no conversation part before turn 1")
        (let* ((r (checkpoint-revision after))
               (prov (rev:revision-provenance r)))
          (ok (equal (checkpoint-id after) (rev:revision-id r)))
          (ok (equal (list (checkpoint-id before)) (rev:revision-parent-ids r)) "one chain")
          (ok (equal "go" (rev:revision-message r)))
          (ok (eq :checkpoint (getf prov :kind)))
          (ok (eq :turn (getf prov :reason)))
          (ok (eql 1 (getf prov :turn)))
          (ok (eql 2 (getf prov :ordinal)))
          (ok (eq kind (getf prov :files-kind)))
          (ok (equal +version+ (getf prov :version))))
        (ok (equal (checkpoint-id after) (rev:ref-target (rev:find-ref cs +checkpoint-ref+))))
        (ok (null (rev:find-ref cs +expired-ref+)))))))

(deftest-parametrize checkpoint-is-a-composite-revision
    ((kind) :ids ("copy" "git") (:copy) (:git))
  (checkpoint-is-a-composite-revision-case kind))

(deftest checkpoint-persists
  (with-project (project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (edit-turn cp s "one" '("a.txt" "beta"))
        (edit-turn cp s "two" '("a.txt" "gamma"))
        (let* ((dir (project-sessions project config))
               (again (open-session dir (session-id s)))
               (old (session-checkpoints s))
               (new (session-checkpoints again))
               (cdir (checkpoints-directory s)))
          (ok (equal '(:before :turn :turn) (reasons new)))
          (ok (equal (ids old) (ids new)))
          (ok (equal '(0 1 2) (mapcar #'checkpoint-turn new)))
          (ok (equal (mapcar #'checkpoint-turn-id old) (mapcar #'checkpoint-turn-id new)))
          (ok (equal (mapcar #'checkpoint-files-id old) (mapcar #'checkpoint-files-id new)))
          (ok (equal '("session start" "one" "two") (mapcar #'checkpoint-message new)))
          (ok (equal (mapcar (lambda (k) (dt:instant-seconds (checkpoint-recorded-at k))) old)
                     (mapcar (lambda (k) (dt:instant-seconds (checkpoint-recorded-at k))) new)))
          (ok (equal "gamma" (checkpoint-file (third new) again project "a.txt")))
          (dolist (k new)
            (ok (probe-file (merge-pathnames (format nil "revisions/~a.sexp" (checkpoint-id k)) cdir))
                "one revision file per checkpoint"))
          (ok (equal (format nil "~a~%" (checkpoint-id (third new)))
                     (file-string (merge-pathnames "refs/checkpoints" cdir))))
          (ok (not (probe-file (merge-pathnames "last" cdir))) "no \"last\" in the checkpoints directory")
          (ok (equal (format nil "~a~%" (session-id s)) (file-string (merge-pathnames "last" dir)))
              "the sessions directory's last still names the session")
          (let ((m (rev:composite-manifest (checkpoint-store again) (checkpoint-id (third new)))))
            (destructuring-bind (files conversation) (rev:manifest-parts m)
              (ok (null (rev:part-store files)))
              (ok (eq again (rev:part-store conversation))
                  "read back, the conversation part is the reopened session"))))))))

;;; The files at a turn.

(deftest checkpoint-files-at-a-turn
  (with-project (project config) '(("a.txt" "v0"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (edit-turn cp s "t1")
        (edit-turn cp s "t2")
        (destructuring-bind (b3 c3) (edit-turn cp s "t3" '("a.txt" "v3"))
          (edit-turn cp s "t4")
          (let ((c5 (first (edit-turn cp s "t5" '("a.txt" "v5")))))
            (ok (eq :before (checkpoint-reason b3)))
            (ok (= 2 (checkpoint-turn b3)) "the :before of turn 3 belongs to turn 2")
            (flet ((at (designator)
                     (let ((k (turn-checkpoint s designator)))
                       (and k (checkpoint-id k)))))
              (ok (equal (checkpoint-id b3) (at "0")) "before the first checkpoint: the first one")
              (ok (equal (checkpoint-id b3) (at "1")))
              (ok (equal (checkpoint-id b3) (at "2")))
              (ok (equal (checkpoint-id c3) (at "3")))
              (ok (equal (checkpoint-id c3) (at "4")) "turn 4 changed nothing")
              (ok (equal (checkpoint-id c5) (at "5")))
              (ok (equal (checkpoint-id c3) (at (short-id (checkpoint-turn-id c3)))) "an id prefix")
              (ok (typep (failure (turn-checkpoint s "9")) 'session-turn-not-found))
              (ok (typep (failure (turn-checkpoint s "x")) 'session-turn-not-found))
              (let ((t5 (checkpoint-turn-id c5)))
                (move-session-head s (checkpoint-turn-id c3))
                (edit-turn cp s "t4 again")
                (ok (equal (checkpoint-id c3) (at "4")) "turn 4 of the new line")
                (ok (equal (checkpoint-id c5) (at (short-id t5))) "a turn on another branch, by id")))))))))

(deftest checkpoint-files-at-a-turn-without-checkpoints
  (with-project (project config) '(("a.txt" "v0"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (ok (null (turn-checkpoint s "0")) "an empty session")
        (edit-turn cp s "t1")
        (ok (null (turn-checkpoint s "1")) "no checkpoint at all")))))

(deftest checkpoint-find
  (with-project (project config) '(("a.txt" "v0"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (k (second (edit-turn cp s "t1" '("a.txt" "v1")))))
        (ok (equal (checkpoint-id k) (checkpoint-id (find-checkpoint s (checkpoint-id k)))))
        (ok (equal (checkpoint-id k) (checkpoint-id (find-checkpoint s (subseq (checkpoint-id k) 0 6)))))
        (let ((c (failure (find-checkpoint s "ffffffff"))))
          (ok (typep c 'checkpoint-not-found))
          (ok (equal "ffffffff" (checkpoint-not-found-designator c)))
          (ok (has (format nil "session ~a has no checkpoint ffffffff" (session-id s))
                   (princ-to-string c))))
        (ok (typep (failure (find-checkpoint s (subseq (checkpoint-id k) 0 3))) 'checkpoint-not-found)
            "prefixes are at least 4 characters")))))

;;; Rewind.

(defun checkpoint-rewind-files-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha
") ("c.txt" "gamma
"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config))
            (original (disk-files project)))
        (multiple-value-bind (recorded turn)
            (edit-turn cp s "change" (list "a.txt" (nl "beta")) (list "b.txt" (nl "new")) '("c.txt" nil))
          (ok (= 2 (length recorded)))
          (let ((result (rewind-to cp s "0" :parts '(:files))))
            (ok (equal original (disk-files project)) "the files are as before turn 1")
            (ok (eq :applied (getf result :files)))
            (ok (eq :skipped (getf result :conversation)))
            (ok (eql 0 (getf result :turn)))
            (ok (equal '(:files) (getf result :parts)))
            (ok (equal '((:modified "a.txt") (:removed "b.txt") (:added "c.txt")) (getf result :changes)))
            (ok (null (getf result :conflicts)))
            (ok (null (getf result :drift)))
            (ok (equal "files (3 files changed)" (rewind-description result)))
            (ok (equal (rev:revision-id turn) (rev:revision-id (session-head s))) "the conversation stays")
            (let ((k (getf result :checkpoint)))
              (ok (and k (eq :rewind (checkpoint-reason k))))
              (ok (and k (equal (rev:revision-id turn) (checkpoint-turn-id k)))
                  "its conversation part is the head")
              (ok (and k (equal (checkpoint-id k) (checkpoint-id (tip-checkpoint s)))))
              (ok (and k (equal (nl "alpha") (checkpoint-file k s project "a.txt"))))
              (ok (and k (null (checkpoint-file k s project "b.txt")))))
            (when (eq kind :git)
              (ok (equal "" (git project "status" "--porcelain")) "back to the committed state"))))))))

(deftest-parametrize checkpoint-rewind-files
    ((kind) :ids ("copy" "git" "jj") (:copy) (:git) (:jj))
  (checkpoint-rewind-files-case kind))

(deftest checkpoint-rewind-both-parts
  (with-project (project config) '(("a.txt" "zero"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (multiple-value-bind (r1 t1) (edit-turn cp s "one" '("a.txt" "one"))
          (declare (ignore r1))
          (edit-turn cp s "two" '("a.txt" "two"))
          (let ((result (rewind-to cp s "1")))
            (ok (equal "one" (read-file project "a.txt")))
            (ok (equal (rev:revision-id t1) (rev:revision-id (session-head s))))
            (ok (equal '("one") (line-prompts s)))
            (ok (equal (rev:revision-id t1) (session-base s)))
            (ok (eq :moved (getf result :conversation)))
            (ok (eq :applied (getf result :files)))
            (ok (equal +rewind-parts+ (getf result :parts)))
            (ok (eql 1 (getf result :turn)))
            (ok (equal "conversation and files (1 file changed)" (rewind-description result)))
            (ok (equal (rev:revision-id t1) (checkpoint-turn-id (getf result :checkpoint)))
                "the :rewind checkpoint is on the new head"))
          (edit-turn cp s "three" '("a.txt" "three"))
          (ok (equal '("one" "three") (line-prompts s)) "the next turn continues from turn 1")
          (let ((again (rewind-to cp s "1" :parts '(:files))))
            (ok (eq :applied (getf again :files)) "no drift: the tip is the base")
            (ok (null (getf again :drift)))
            (ok (equal "one" (read-file project "a.txt")))))))))

(deftest checkpoint-rewind-conversation-only
  (with-project (project config) '(("a.txt" "zero"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (multiple-value-bind (r1 t1) (edit-turn cp s "one" '("a.txt" "one"))
          (declare (ignore r1))
          (edit-turn cp s "two" '("a.txt" "two"))
          (let ((n (length (session-checkpoints s :all t)))
                (same (rewind-to cp s "2" :parts '(:conversation))))
            (ok (eq :unchanged (getf same :conversation)) "already there")
            (let ((result (rewind-to cp s "1" :parts '(:conversation))))
              (ok (equal "two" (read-file project "a.txt")) "the files stay")
              (ok (equal (rev:revision-id t1) (rev:revision-id (session-head s))))
              (ok (eq :moved (getf result :conversation)))
              (ok (eq :skipped (getf result :files)))
              (ok (null (getf result :checkpoint)))
              (ok (equal "conversation" (rewind-description result)))
              (ok (= n (length (session-checkpoints s :all t))) "nothing recorded"))
            (let ((start (rewind-to cp s "0" :parts '(:conversation))))
              (ok (null (session-head s)) "turn 0: the head is deleted")
              (ok (eq :moved (getf start :conversation)))
              (ok (eql 0 (getf start :turn))))))))))

(defun checkpoint-rewind-drift-case (kind answer)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha
") ("keep.txt" "keep
"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (multiple-value-bind (recorded turn) (edit-turn cp s "beta" (list "a.txt" (nl "beta")))
          (declare (ignore recorded))
          (write-file project "a.txt" (nl "user"))
          (write-file project "u.txt" (nl "mine"))
          (let* ((n (length (session-checkpoints s :all t)))
                 (seen nil)
                 (result
                   (handler-bind ((plan-drift
                                    (lambda (c)
                                      (setf seen (list (plan-drift-paths c)
                                                       (plan-error-plan c)
                                                       (and (find-restart 'rebase-plan c)
                                                            (find-restart 'overwrite-plan c)
                                                            (find-restart 'abort-approval c)
                                                            t)
                                                       (read-file project "a.txt")))
                                      (invoke-restart (find-restart (ecase answer
                                                                      (:abort 'abort-approval)
                                                                      (:overwrite 'overwrite-plan)
                                                                      (:rebase 'rebase-plan))
                                                                    c)))))
                     (rewind-to cp s "0"))))
            (ok seen "PLAN-DRIFT was signalled")
            (destructuring-bind (&optional paths plan restarts text) seen
              (ok (equal '("a.txt") paths))
              (ok restarts "rebase-plan, overwrite-plan and abort-approval")
              (ok (equal (nl "user") text) "nothing written before the answer")
              (ok (and plan (eq :copy (plan-kind plan))) "a rewind plan is a copy plan")
              (ok (and plan (equal (session-id s) (getf (plan-rewind plan) :session)))))
            (ok (equal '("a.txt") (getf result :drift)))
            (ok (equal (nl "mine") (read-file project "u.txt")) "the user's other work stays")
            (ok (equal (nl "keep") (read-file project "keep.txt")))
            (ecase answer
              (:abort
               (ok (eq :aborted (getf result :files)))
               (ok (eq :unchanged (getf result :conversation)) "the conversation waits for the files")
               (ok (equal (nl "user") (read-file project "a.txt")))
               (ok (equal (rev:revision-id turn) (rev:revision-id (session-head s))))
               (ok (null (getf result :checkpoint)))
               (ok (= n (length (session-checkpoints s :all t))))
               (ok (equal "nothing restored" (rewind-description result)))
               (let ((on-disk (and (second seen)
                                   (find (plan-id (second seen)) (project-plans project config)
                                         :key #'plan-id :test #'equal))))
                 (ok (and on-disk (eq :discarded (plan-status on-disk)))
                     "the rewind plan is discarded")))
              (:overwrite
               (ok (eq :applied (getf result :files)))
               (ok (eq :moved (getf result :conversation)))
               (ok (equal (nl "alpha") (read-file project "a.txt")))
               (ok (null (session-head s)))
               (ok (equal '((:modified "a.txt")) (getf result :changes))))
              (:rebase
               (ok (eq :merged (getf result :files)))
               (ok (equal (rewind-merge (nl "beta") (nl "alpha") (nl "user")) (read-file project "a.txt"))
                   "DIFF:MERGE-TEXTS of the tip, the checkpoint and the working copy")
               (ok (has "<<<<<<< plan" (read-file project "a.txt")))
               (ok (equal '("a.txt") (getf result :conflicts)))
               (ok (equal '((:modified "a.txt")) (getf result :changes)))
               (ok (null (session-head s)))
               (ok (equal "conversation and files (1 file changed, merged with the working copy; conflicts in a.txt)"
                          (rewind-description result)))))))))))

(deftest-parametrize checkpoint-rewind-drift
    ((kind answer)
     :ids ("copy-abort" "copy-overwrite" "copy-rebase" "git-abort" "git-overwrite" "git-rebase")
     (:copy :abort) (:copy :overwrite) (:copy :rebase)
     (:git :abort) (:git :overwrite) (:git :rebase))
  (checkpoint-rewind-drift-case kind answer))

(deftest checkpoint-rewind-clean-merge
  (with-project (project config) '(("a.txt" "1
2
3
4
5
6
7
8
9
"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (edit-turn cp s "agent" (list "a.txt" (nl "1" "2" "agent" "4" "5" "6" "7" "8" "9")))
        (write-file project "a.txt" (nl "1" "2" "agent" "4" "5" "6" "7" "8" "user"))
        (let ((result (handler-bind ((plan-drift (lambda (c) (invoke-restart (find-restart 'rebase-plan c)))))
                        (rewind-to cp s "0" :parts '(:files)))))
          (ok (eq :merged (getf result :files)))
          (ok (null (getf result :conflicts)))
          (ok (equal (nl "1" "2" "3" "4" "5" "6" "7" "8" "user") (read-file project "a.txt"))
              "the agent's line is undone, the user's line kept")
          (ok (equal "files (1 file changed, merged with the working copy)" (rewind-description result))))))))

(deftest checkpoint-rewind-errors
  (with-project (project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (edit-turn cp s "look")
        (let ((c (failure (rewind-to cp s "0" :parts '(:files)))))
          (ok (typep c 'checkpoint-not-found))
          (ok (equal "0" (checkpoint-not-found-designator c)))
          (ok (has (format nil "session ~a has no checkpoint for turn 0" (session-id s))
                   (princ-to-string c))))
        (ok (typep (failure (rewind-to cp s "7")) 'session-turn-not-found))
        (ok (typep (failure (rewind-to cp s "1" :parts '(:db))) 'type-error))
        (ok (typep (failure (rewind-to cp s "1" :parts '())) 'type-error))
        (edit-turn cp s "change" '("a.txt" "beta"))
        (commit (open-session (project-sessions project config) (session-id s)) "elsewhere")
        (let ((c (failure (rewind-to cp s "1"))))
          (ok (typep c 'session-conflict) "another process moved the head")
          (ok (equal "beta" (read-file project "a.txt")) "nothing restored"))))))

;;; Retention.

(defun checkpoint-retention-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "v0
"))
    (with-checkpointer (cp project config :keep 2)
      (let ((s (fresh-session project config)))
        (edit-turn cp s "one" (list "a.txt" (nl "v1")))
        (edit-turn cp s "two" (list "a.txt" (nl "v2")))
        (edit-turn cp s "three" (list "a.txt" (nl "v3")))
        (let ((all (session-checkpoints s :all t))
              (kept (session-checkpoints s)))
          (ok (= 4 (length all)))
          (ok (equal '(t t nil nil) (mapcar (lambda (k) (and (checkpoint-expired-p k) t)) all)))
          (ok (equal (ids (last all 2)) (ids kept)))
          (ok (equal (checkpoint-id (second all))
                     (rev:ref-target (rev:find-ref (checkpoint-store s) +expired-ref+))))
          (ok (= 2 (length (checkpoint-summary-lines s))))
          (ecase kind
            (:git
             (ok (equal (list (checkpoint-ref-name s 3) (checkpoint-ref-name s 4))
                        (checkpoint-refs project s))
                 "the expired checkpoints' private refs are gone"))
            (:copy
             (let ((blobs (blob-store s)))
               (ok (not (p:snapshot-store-contains-p blobs (ascii-hash (nl "v0"))))
                   "content only expired checkpoints used is swept")
               (ok (not (p:snapshot-store-contains-p blobs (checkpoint-files-id (first all))))
                   "with their manifests")
               (ok (p:snapshot-store-contains-p blobs (ascii-hash (nl "v2"))))
               (ok (p:snapshot-store-contains-p blobs (checkpoint-files-id (third all)))))))
          (let ((c (failure (rewind-to cp s "1" :parts '(:files)))))
            (ok (typep c 'checkpoint-expired))
            (ok (and (typep c 'checkpoint-expired)
                     (equal (checkpoint-id (second all))
                            (checkpoint-id (checkpoint-expired-checkpoint c)))))
            (ok (has "was garbage-collected" (princ-to-string c)))
            (ok (equal (nl "v3") (read-file project "a.txt")) "nothing restored"))
          (ok (eq :applied (getf (rewind-to cp s "2" :parts '(:files)) :files)) "a retained one works")
          (ok (equal (nl "v2") (read-file project "a.txt")))
          (ok (= 5 (length (session-checkpoints s :all t))))
          (ok (= 2 (length (session-checkpoints s))))))
      (with-checkpointer (wide project config :keep 10)
        (let ((s (open-session (project-sessions project config)
                               (first (directory-names (project-sessions project config))))))
          (edit-turn wide s "four" (list "a.txt" (nl "v4")))
          (ok (= 3 (length (session-checkpoints s)))
              "raising keep does not revive expired checkpoints"))))))

(deftest-parametrize checkpoint-retention
    ((kind) :ids ("copy" "git") (:copy) (:git))
  (checkpoint-retention-case kind))

(deftest checkpoint-disabled
  (with-project (project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config :enabled nil)
      (ok (not (checkpointer-enabled-p cp)))
      (let ((s (fresh-session project config)))
        (ok (null (begin-checkpoint-turn cp s)))
        (ok (null (edit-turn cp s "go" '("a.txt" "beta"))))
        (ok (null (session-checkpoints s)))
        (ok (not (uiop:directory-exists-p (checkpoints-directory s))) "nothing written")
        (let ((k (record-checkpoint cp s :turn :turn (session-head s))))
          (ok (eq :turn (checkpoint-reason k)) "an explicit record still works")
          (ok (equal "beta" (checkpoint-file k s project "a.txt")))
          (ok (equal (list (checkpoint-id k)) (ids (session-checkpoints s)))))))))

;;; Views.

(deftest checkpoint-summary-lines-format
  (with-project (project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config)
      (let ((s (fresh-session project config)))
        (ok (equal '("no checkpoints yet") (checkpoint-summary-lines s)))
        (destructuring-bind (b c) (edit-turn cp s "fix the parser" '("a.txt" "beta"))
          (let ((full (format nil "● ~a turn 1 after fix the parser" (short-id c))))
            (ok (equal (list full (format nil "● ~a turn 0 before session start" (short-id b)))
                       (checkpoint-summary-lines s))
                "newest first")
            (let ((cut (first (checkpoint-summary-lines s :width 24))))
              (ok (equal (concatenate 'string (subseq full 0 23) "…") cut))))
          (rewind-session s 1)
          (ok (equal (list (format nil "○ ~a turn 1 after fix the parser" (short-id c))
                           (format nil "● ~a turn 0 before session start" (short-id b)))
                     (checkpoint-summary-lines s))
              "a turn off the head's line"))))))

(deftest-parametrize checkpoint-summary-labels
    ((reason label)
     :ids ("before" "turn" "plan-before" "plan-after" "rewind")
     (:before "before") (:turn "after") (:plan-before "plan-before") (:plan-after "plan-after")
     (:rewind "rewind"))
  (with-project (project config) '(("a.txt" "alpha"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (turn (commit s "the turn"))
             (k (record-checkpoint cp s reason :turn turn)))
        (ok (equal (list (format nil "● ~a turn 1 ~a the turn" (short-id k) label))
                   (checkpoint-summary-lines s)))))))

(deftest checkpoint-tree-marks
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "first question"))
           (r2 (commit s "second question")))
      (ok (equal (list (format nil "● ~a first question ◆" (short-id r1))
                       (format nil "● ~a second question  (head)" (short-id r2)))
                 (session-tree-lines s :marked (list (rev:revision-id r1)))))
      (ok (equal (list (format nil "● ~a first question" (short-id r1))
                       (format nil "● ~a second question ◆  (head)" (short-id r2)))
                 (session-tree-lines s :marked (list (rev:revision-id r2)))))
      (ok (equal (list (format nil "● ~a first question" (short-id r1))
                       (format nil "● ~a se… ◆  (head)" (short-id r2)))
                 (session-tree-lines s :width 24 :marked (list (rev:revision-id r2))))
          "the marker is never cut"))))

;;; Plan mode.

(defun checkpoint-plan-approval-case (kind)
  (with-checkpoint-project (kind project config) '(("a.txt" "alpha
"))
    (with-checkpointer (cp project config)
      (let* ((s (fresh-session project config))
             (turn (commit s "plan it"))
             (plan (open-test-plan project config :auto)))
        (write-area plan "a.txt" (nl "beta"))
        (multiple-value-bind (result status pre) (approve-plan plan :checkpointer cp)
          (ok (eq :applied status))
          (ok (equal '((:modified "a.txt")) result))
          (ok (files-state-p pre))
          (ok (null (session-checkpoints s)) "approve-plan records nothing itself")
          (let ((ks (record-plan-checkpoints cp s pre turn)))
            (ok (equal '(:plan-before :plan-after) (reasons ks)))
            (ok (equal (ids ks) (ids (session-checkpoints s))))
            (ok (every (lambda (k) (equal (rev:revision-id turn) (checkpoint-turn-id k))) ks))
            (ok (equal (nl "alpha") (checkpoint-file (first ks) s project "a.txt")))
            (ok (equal (nl "beta") (checkpoint-file (second ks) s project "a.txt")))))
        (ok (null (record-plan-checkpoints cp s nil turn)) "no PRE, nothing recorded")
        (ok (eq :applied (getf (rewind-to cp s "0" :parts '(:files)) :files)))
        (ok (equal (nl "alpha") (read-file project "a.txt")) "a rewind undoes the approved plan")
        (let ((n (length (session-checkpoints s :all t)))
              (plan2 (open-test-plan project config :auto)))
          (write-area plan2 "a.txt" (nl "gamma"))
          (write-file project "a.txt" (nl "user"))
          (multiple-value-bind (result status pre)
              (handler-bind ((plan-drift (lambda (c) (invoke-restart (find-restart 'abort-approval c)))))
                (approve-plan plan2 :checkpointer cp))
            (declare (ignore result))
            (ok (eq :aborted status))
            (ok (null pre) "an aborted approval has no PRE"))
          (ok (= n (length (session-checkpoints s :all t)))))))))

(deftest-parametrize checkpoint-plan-approval
    ((kind) :ids ("copy" "git") (:copy) (:git))
  (checkpoint-plan-approval-case kind))

(deftest checkpoint-plan-approval-without-checkpointer
  (with-project (project config) '(("a.txt" "alpha"))
    (let ((plan (open-test-plan project config :auto)))
      (write-area plan "a.txt" "beta")
      (ok (equal '(((:modified "a.txt")) :applied) (multiple-value-list (approve-plan plan)))
          "H5a's two values without a checkpointer"))))

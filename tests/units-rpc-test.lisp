(in-package #:cl-stack-code/tests)

;;; H8d --rpc: units/list, units/subscribe (replay since a seq, no gaps),
;;; units/unsubscribe, units/read, units/search, units/control, their errors,
;;; and the same state as the SDK. SERVE-RPC on an in-memory pair, the
;;; fixture turn of units-client-test (UNITS-FIXTURE-STEPS).

(defun call-with-units-rpc (project config fn &key rules (steps (units-fixture-steps)))
  "FN gets (rpc backend session-id) after the fixture turn's result arrived."
  (with-rpc (rpc backend project config :steps steps :settings (apply #'allow-bash rules))
    (let ((id (new-session rpc)))
      (call rpc "turn/start" "session_id" id "prompt" "start the units")
      (rpc-result rpc id :timeout 60)
      (funcall fn rpc backend id))))

(defmacro with-units-rpc ((rpc backend id &rest keys) (project config) &body body)
  `(call-with-units-rpc ,project ,config
                        (lambda (,rpc ,backend ,id) (declare (ignorable ,rpc ,backend ,id)) ,@body)
                        ,@keys))

(defun rpc-units (rpc id &rest kv)
  (coerce (jget (apply #'call rpc "units/list" "session_id" id kv) "units") 'list))

(defun rpc-unit-events (rpc id)
  (rpc-client-events rpc :type "unit" :session-id id))

(deftest units-rpc-initialize
  (with-project (project config) '()
    (with-rpc (rpc backend project config)
      (let ((init (call rpc "initialize")))
        (ok (every (lambda (m) (find m (jget init "methods") :test #'equal))
                   '("units/list" "units/subscribe" "units/unsubscribe" "units/read" "units/search"
                     "units/control")))
        (ok (find "unit" (jget init "events") :test #'equal))))))

(deftest units-rpc-list
  (with-project (project config) '()
    (with-units-rpc (rpc backend id) (project config)
      (let ((r (call rpc "units/list" "session_id" id)))
        (ok (same-keys '("units" "seq" "running") r))
        (ok (and (integerp (jget r "seq")) (plusp (jget r "seq"))))
        (ok (eql 2 (jget r "running")))
        (let ((units (coerce (jget r "units") 'list)))
          (ok (equal '("shell-job-1" "shell-job-2" "shell-job-3" "shell-job-4") (ids-of units)))
          (ok (equal +fixture-status+ (mapcar (lambda (o) (jget o "status")) units)))
          (ok (every (lambda (o) (same-keys +unit-object-keys+ o)) units))))
      (ok (equal '("shell-job-2" "shell-job-3") (ids-of (rpc-units rpc id "state" "live"))))
      (ok (equal '("shell-job-4") (ids-of (rpc-units rpc id "state" "failed"))))
      (ok (null (rpc-units rpc id "kind" "rpc")))
      (let ((sleeper (find "shell-job-2" (rpc-units rpc id "resources" t) :key (lambda (o) (jget o "id"))
                                                                          :test #'equal)))
        (ok (integerp (jget sleeper "rss_bytes"))))
      (ok (eql -32602 (fault rpc "units/list" "session_id" id "state" 5)))
      (ok (eql -32602 (fault rpc "units/list" "session_id" id "state" "zzz")))
      (ok (eql -32002 (fault rpc "units/list" "session_id" "nope")) "an unknown session"))))

(deftest units-rpc-same-state-as-sdk
  (with-project (project config) '()
    (let ((sdk (with-units-session (client s sup backend events) (project config)
                 (mapcar (lambda (o) (list (jget o "id") (jget o "kind") (jget o "status") (jget o "owner")))
                         (client-units s))))
          (rpc (with-units-rpc (rpc backend id) (project config)
                 (mapcar (lambda (o) (list (jget o "id") (jget o "kind") (jget o "status") (jget o "owner")))
                         (rpc-units rpc id)))))
      (ok (= 4 (length rpc)))
      (ok (equal sdk rpc) "the same script gives the same units"))))

(deftest units-rpc-subscribe-replay
  (with-project (project config) '()
    (with-units-rpc (rpc backend id) (project config)
      (let* ((last (jget (call rpc "units/list" "session_id" id) "seq"))
             (r (call rpc "units/subscribe" "session_id" id "since" 0)))
        (ok (same-keys '("subscription" "seq" "complete") r))
        (ok (equal "sub-1" (jget r "subscription")))
        (ok (eql last (jget r "seq")))
        (ok (eq t (jget r "complete")))
        (ok (wait-until (lambda () (>= (length (rpc-unit-events rpc id)) last))) "the replay")
        (let ((events (rpc-unit-events rpc id)))
          (ok (equal (loop for i from 1 to last collect i)
                     (mapcar (lambda (e) (jget e "seq")) (subseq events 0 last))))
          (ok (every (lambda (e) (equal "sub-1" (jget e "subscription"))) events))
          (ok (find-if (lambda (e) (and (equal "shell-job-4" (jget e "unit_id")) (equal "failed" (jget e "to"))
                                        (eql 3 (jget e "detail" "exit_code"))))
                       events)
              "the failed unit's final state"))
        (call rpc "units/control" "session_id" id "unit" "shell-job-2" "action" "stop" "confirmed" t)
        (ok (wait-until (lambda () (find-if (lambda (e) (and (equal "shell-job-2" (jget e "unit_id"))
                                                             (equal "killed" (jget e "to"))))
                                            (rpc-unit-events rpc id))))
            "then live events")
        (let ((seqs (mapcar (lambda (e) (jget e "seq")) (rpc-unit-events rpc id))))
          (ok (equal (loop for i from 1 to (length seqs) collect i) seqs) "no gap, no duplicate"))
        (ok (eq t (jget (call rpc "units/unsubscribe" "session_id" id "subscription" "sub-1") "unsubscribed")))
        (multiple-value-bind (code data) (fault rpc "units/unsubscribe" "session_id" id "subscription" "sub-1")
          (ok (eql -32018 code))
          (ok (equal "sub-1" (jget data "subscription"))))
        (ok (eql -32602 (fault rpc "units/subscribe" "session_id" id "since" "x")))))))

(deftest units-rpc-subscribe-live-only
  (with-project (project config) '()
    (with-units-rpc (rpc backend id) (project config)
      (let ((r (call rpc "units/subscribe" "session_id" id)))
        (sleep 0.5)
        (ok (null (rpc-unit-events rpc id)) "no replay without since")
        (call rpc "units/control" "session_id" id "unit" "shell-job-2" "action" "stop" "confirmed" t)
        (ok (wait-until (lambda () (rpc-unit-events rpc id))))
        (ok (every (lambda (e) (> (jget e "seq") (jget r "seq"))) (rpc-unit-events rpc id)))))))

(deftest units-rpc-read
  (with-project (project config) '()
    (with-units-rpc (rpc backend id) (project config)
      (let* ((r (call rpc "units/read" "session_id" id "unit" "shell-job-1"))
             (rec (find-if (lambda (o) (search +alpha+ (jget o "text"))) (coerce (jget r "records") 'list))))
        (ok (equal "exited 0" (jget r "status")))
        (ok rec)
        (ok (eq t (jget r "ended")))
        (let ((by-ref (call rpc "units/read" "session_id" id
                            "ref" (format nil "shell-job-1:1:~d" (jget rec "line")))))
          (ok (find (jget rec "line") (coerce (jget by-ref "records") 'list) :key (lambda (o) (jget o "line")))))
        (ok (= 1 (length (jget (call rpc "units/read" "session_id" id "unit" "shell-job-1" "tail" 1) "records")))))
      (multiple-value-bind (code data) (fault rpc "units/read" "session_id" id "unit" "shell-job-9")
        (ok (eql -32015 code))
        (ok (equal "shell-job-9" (jget data "unit"))))
      (ok (eql -32602 (fault rpc "units/read" "session_id" id "unit" "shell-job-1" "ref" "shell-job-1:1:2")))
      (ok (eql -32602 (fault rpc "units/read" "session_id" id)))
      (ok (eql -32602 (fault rpc "units/read" "session_id" id "unit" "shell-job-1" "limit" 0))))))

(deftest units-rpc-search
  (with-project (project config) '()
    (with-units-rpc (rpc backend id) (project config)
      (let* ((read (call rpc "units/read" "session_id" id "unit" "shell-job-1"))
             (rec (find-if (lambda (o) (search +alpha+ (jget o "text"))) (coerce (jget read "records") 'list)))
             (r (call rpc "units/search" "session_id" id "query" +alpha+))
             (hit (first (coerce (jget r "hits") 'list))))
        (ok (>= (jget r "total") 1))
        (ok (equal "shell-job-1" (jget hit "unit")))
        (ok (eql (jget rec "line") (jget hit "line")) "the hit is the line units/read shows")
        (ok (has +alpha+ (jget hit "text"))))
      (ok (>= (jget (call rpc "units/search" "session_id" id "query" "" "kinds" #("exit")) "total") 2))
      (ok (eql -32602 (fault rpc "units/search" "session_id" id "query" +alpha+ "k" 0)))
      (ok (eql -32602 (fault rpc "units/search" "session_id" id "query" +alpha+ "kinds" #("nope")))))))

(deftest units-rpc-control
  (with-project (project config) '()
    (with-units-rpc (rpc backend id) (project config)
      (multiple-value-bind (code data) (fault rpc "units/control" "session_id" id "unit" "shell-job-2"
                                              "action" "stop")
        (ok (eql -32017 code) "ask: the client confirms with its user")
        (ok (equal "stop:shell-job-2" (jget data "resource")))
        (ok (equal "stop" (jget data "action"))))
      (ok (equal "running" (jget (find "shell-job-2" (rpc-units rpc id) :key (lambda (o) (jget o "id"))
                                                                       :test #'equal)
                                 "status"))
          "nothing done")
      (let ((r (call rpc "units/control" "session_id" id "unit" "shell-job-2" "action" "stop" "confirmed" t)))
        (ok (equal "Stopped shell-job-2: killed" (jget r "result")))
        (ok (equal "killed" (jget r "unit" "status"))))
      (call rpc "units/control" "session_id" id "unit" "shell-job-3" "action" "input"
                "input" (format nil "pear~%apple~%") "confirmed" t)
      (call rpc "units/control" "session_id" id "unit" "shell-job-3" "action" "close_input" "confirmed" t)
      (ok (wait-until (lambda () (equal "exited 0" (jget (find "shell-job-3" (rpc-units rpc id)
                                                                 :key (lambda (o) (jget o "id")) :test #'equal)
                                                          "status")))))
      (ok (wait-until (lambda ()
                        (equal '("apple" "pear")
                               (mapcar (lambda (o) (string-right-trim '(#\Return) (jget o "text")))
                                       (coerce (jget (call rpc "units/read" "session_id" id "unit" "shell-job-3")
                                                     "records")
                                               'list)))))
          "sort read the input, then EOF")
      (multiple-value-bind (code data) (fault rpc "units/control" "session_id" id "unit" "shell-job-1"
                                              "action" "input" "input" "x" "confirmed" t)
        (ok (eql -32019 code) "input to a finished unit")
        (ok (equal "shell-job-1" (jget data "unit"))))
      (ok (eql -32602 (fault rpc "units/control" "session_id" id "unit" "shell-job-1" "action" "kill")))
      (ok (eql -32015 (fault rpc "units/control" "session_id" id "unit" "shell-job-9" "action" "stop"
                                                 "confirmed" t))))))

(deftest units-rpc-control-deny
  (with-project (project config) '()
    (with-units-rpc (rpc backend id :rules '("unit_control(stop:*)!")) (project config)
      (multiple-value-bind (code data) (fault rpc "units/control" "session_id" id "unit" "shell-job-2"
                                              "action" "stop" "confirmed" t)
        (ok (eql -32016 code))
        (ok (equal "unit_control(stop:*)" (jget data "rule")))
        (ok (equal "shell-job-2" (jget data "unit"))))
      (ok (equal "running" (jget (find "shell-job-2" (rpc-units rpc id) :key (lambda (o) (jget o "id"))
                                                                       :test #'equal)
                                 "status"))))))

(in-package #:cl-stack-code/tests)

;;; The session store (src/sessions.lisp): where sessions live, records,
;;; persistence, CAS across stores, locks, clones, rewinds and forks.

;;; Where.

(deftest-parametrize data-directory-precedence
    ((env platform expected)
     :ids ("own-var" "xdg" "windows-localappdata" "posix-home" "relative-ignored"
           "empty-ignored" "own-beats-xdg" "xdg-beats-localappdata" "posix-ignores-localappdata")
     ('("CL_STACK_CODE_DATA_DIR" "/d/own/") :posix "/d/own/")
     ('("XDG_DATA_HOME" "/d/xdg") :posix "/d/xdg/cl-stack-code/")
     ('("LOCALAPPDATA" "/d/lad") :windows "/d/lad/cl-stack-code/")
     (nil :posix :home)
     ('("CL_STACK_CODE_DATA_DIR" "rel/dir" "XDG_DATA_HOME" "also/rel") :posix :home)
     ('("CL_STACK_CODE_DATA_DIR" "" "XDG_DATA_HOME" "") :posix :home)
     ('("CL_STACK_CODE_DATA_DIR" "/d/own/" "XDG_DATA_HOME" "/d/xdg") :posix "/d/own/")
     ('("XDG_DATA_HOME" "/d/xdg" "LOCALAPPDATA" "/d/lad") :windows "/d/xdg/cl-stack-code/")
     ('("LOCALAPPDATA" "/d/lad") :posix :home))
  (let ((dir (user-data-directory :getenv (apply #'env-lookup env) :platform platform)))
    (ok (uiop:directory-pathname-p dir) "a directory pathname")
    (ok (equal (if (eq expected :home)
                   (native (merge-pathnames ".local/share/cl-stack-code/" (user-homedir-pathname)))
                   (native (uiop:parse-native-namestring expected :ensure-directory t)))
               (native dir)))))

(deftest-parametrize project-session-keys
    ((dir key)
     :ids ("plain" "spaces-and-dots" "trailing-separator-dropped")
     ("/Users/me/proj/" "-Users-me-proj")
     ("/Users/me/my proj.v2/" "-Users-me-my-proj-v2")
     ("/a/b-c/d_e/" "-a-b-c-d-e"))
  #-(or windows win32)
  (ok (equal key (project-session-key (uiop:parse-native-namestring dir :ensure-directory t))))
  #+(or windows win32)
  (skip "POSIX paths"))

(deftest sessions-directory-is-keyed-by-project
  (with-project (project config) '("sub/")
    (let* ((data (data-dir-of config))
           (dir (sessions-directory project :data-dir data))
           (from-sub (sessions-directory (subdir project "sub/") :data-dir data)))
      (ok (same-path (uiop:merge-pathnames* (format nil "sessions/~a/" (project-session-key project))
                                            data)
                     dir))
      (ok (same-path dir from-sub) "a subdirectory of the project shares its sessions")
      (ok (not (probe-file dir)) "nothing is created")))
  (with-project (project config :git nil) '("sub/")
    (let* ((data (data-dir-of config))
           (sub (truename (subdir project "sub/"))))
      (ok (same-path (uiop:merge-pathnames* (format nil "sessions/~a/" (project-session-key sub))
                                            data)
                     (sessions-directory sub :data-dir data))
          "without a project root the working directory is the key"))))

(deftest-parametrize session-id-forms
    ((given expected)
     :ids ("hex" "upper-hex" "uuid" "uuid-upper" "short" "long" "not-hex" "bad-uuid" "empty")
     ("0123456789abcdef0123456789abcdef" "0123456789abcdef0123456789abcdef")
     ("0123456789ABCDEF0123456789ABCDEF" "0123456789abcdef0123456789abcdef")
     ("01234567-89ab-cdef-0123-456789abcdef" "0123456789abcdef0123456789abcdef")
     ("01234567-89AB-CDEF-0123-456789ABCDEF" "0123456789abcdef0123456789abcdef")
     ("0123" nil)
     ("0123456789abcdef0123456789abcdef0" nil)
     ("0123456789abcdef0123456789abcdeg" nil)
     ("0123456-789ab-cdef-0123-456789abcdef" nil)
     ("" nil))
  (ok (equal expected (normalize-session-id given))))

;;; Records.

(deftest record-content-round-trip
  (let* ((record (tool-record "read a.txt"))
         (content (record-content record))
         (back (content-record content)))
    (ok (eql 1 (getf content :format)))
    (ok (equal "read a.txt" (getf content :prompt)))
    (ok (equal (mapcar #'llm:turn-state (record-turns record)) (getf content :turns))
        "turns are stored as LLM:TURN-STATE plists")
    (ok (equal '(:format :prompt :turns :replace :finish :model :permission-mode :usage
                 :steering :version)
               (loop for k in content by #'cddr collect k))
        "the documented keys, in order")
    (ok (equal (with-standard-io-syntax
                 (let ((*package* (find-package :keyword)) (*read-eval* nil))
                   (read-from-string (prin1-to-string content))))
               content)
        "it prints and reads back as data")
    (ok (equal "read a.txt" (record-prompt back)))
    (ok (equal (turn-summaries (record-turns record)) (turn-summaries (record-turns back))))
    (ok (equal "mock:alpha" (record-model back)))
    (ok (eq :accept-edits (record-permission-mode back)))
    (ok (equal '(20 10 4 2) (record-usage back)))
    (ok (eq :stop (record-finish back)))
    (ok (equal +version+ (record-version back)))
    (let ((call (find-if #'llm:llm-tool-call-part-p
                         (llm:llm-turn-parts (second (record-turns back))))))
      (ok (and call (equal "c1" (llm:llm-tool-call-part-id call))))
      (ok (and call (equal "{\"file_path\":\"a.txt\"}" (llm:llm-tool-call-part-arguments call)))))
    (ok (typep (failure (content-record '(:format 1 :prompt 3))) 'session-error)
        "a malformed content signals SESSION-ERROR")))

;;; Lazy creation, commits, reopening.

(deftest create-session-writes-nothing
  (with-sessions-dir (dir)
    (let ((s (create-session dir :project-dir #p"/tmp/p/")))
      (ok (session-store-p s))
      (ok (typep s 'rev:revision-store))
      (ok (= 32 (length (session-id s))))
      (ok (every (lambda (c) (digit-char-p c 16)) (session-id s)))
      (ok (null (session-head s)))
      (ok (null (session-turns s)))
      (ok (null (session-base s)))
      (ok (not (probe-file dir)) "no directory until the first write")
      (ok (null (list-sessions dir)))
      (ok (not (equal (session-id s) (session-id (create-session dir)))) "random ids"))))

(deftest commit-turn-and-reopen
  (with-sessions-dir (dir)
    (let* ((s (create-session dir :id "0123456789abcdef0123456789abcdef"))
           (r1 (commit s "first question"))
           (r2 (commit-turn s (tool-record "read a.txt"))))
      (ok (rev:revision-p r1))
      (ok (equal (list (rev:revision-id r1)) (rev:revision-parent-ids r2)))
      (ok (null (rev:revision-parent-ids r1)) "the first turn is a root")
      (ok (equal (rev:revision-id r2) (rev:revision-id (session-head s))))
      (ok (equal (rev:revision-id r2) (session-base s)))
      (ok (equal "first question" (rev:revision-message r1)))
      (ok (equal :turn (getf (rev:revision-provenance r1) :kind)))
      (let ((o (open-session dir "0123456789abcdef0123456789abcdef")))
        (ok (not (eq o s)))
        (ok (equal (session-id s) (session-id o)))
        (ok (equal (rev:revision-id r2) (rev:revision-id (session-head o))))
        (ok (equal (rev:revision-id r2) (session-base o)))
        (ok (equal '("first question" "read a.txt") (line-prompts o)))
        (ok (equal (turn-summaries (session-turns s)) (turn-summaries (session-turns o))))
        (ok (equal '((:user "first question") (:assistant "re: first question")
                     (:user "read a.txt") (:assistant "Let me look.") (:tool "alpha")
                     (:assistant "It says alpha."))
                   (turn-summaries (session-turns o))))
        (ok (dt:= (rev:revision-recorded-at r1)
                  (rev:revision-recorded-at (rev:resolve-revision o (rev:revision-id r1))))
            "recorded times survive the round trip")
        (ok (equal "mock:alpha" (record-model (revision-record (session-head o)))))))))

(deftest session-files-on-disk
  (with-sessions-dir (dir)
    (let* ((s (create-session dir :id "0123456789abcdef0123456789abcdef"
                                  :project-dir #p"/tmp/proj/"))
           (r1 (commit s "one"))
           (file1 (session-file s "revisions/" (format nil "~a.sexp" (rev:revision-id r1))))
           (before (file-string file1)))
      (ok (probe-file (session-file s "session.sexp")))
      (let ((meta (with-standard-io-syntax
                    (let ((*package* (find-package :keyword)) (*read-eval* nil))
                      (read-from-string (file-string (session-file s "session.sexp")))))))
        (ok (eql 1 (getf meta :format)))
        (ok (equal (session-id s) (getf meta :id)))
        (ok (equal (uiop:native-namestring #p"/tmp/proj/") (getf meta :project-dir))))
      (ok before "one file per revision")
      (ok (equal (format nil "~a~%" (rev:revision-id r1))
                 (file-string (session-file s "refs/" "head"))))
      (ok (equal (format nil "~a~%" (session-id s)) (file-string (merge-pathnames "last" dir))))
      (let ((r2 (commit s "two")))
        (ok (equal before (file-string file1)) "a revision file is never rewritten")
        (ok (equal (format nil "~a~%" (rev:revision-id r2))
                   (file-string (session-file s "refs/" "head")))))
      (ok (not (probe-file (session-file s "lock"))) "the lock is released"))))

(deftest session-turns-fold-records
  (with-sessions-dir (dir)
    (let ((s (create-session dir)))
      (commit s "a")
      (commit-turn s (make-turn-record :prompt "b" :replace-p t
                                       :turns (list (llm:user-turn "summary") (llm:user-turn "b")
                                                    (llm:assistant-turn "B"))))
      (commit s "c")
      (ok (equal '((:user "summary") (:user "b") (:assistant "B") (:user "c") (:assistant "re: c"))
                 (turn-summaries (session-turns s)))
          "a replace record drops what came before")
      (ok (equal '((:user "a") (:assistant "re: a"))
                 (turn-summaries (session-turns s (first (session-line s)))))
          "the conversation at an earlier revision")
      (ok (equal '("a" "b" "c") (line-prompts s)))
      (ok (not (eq (first (session-turns s)) (first (session-turns s)))) "fresh turns"))))

(deftest commit-turn-message-and-id
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (long (make-string 100 :initial-element #\x))
           (r1 (commit s (format nil "  first line  ~%second line") "ok" :id (rev-id #\a)))
           (r2 (commit s long)))
      (ok (equal (rev-id #\a) (rev:revision-id r1)) ":id is the revision id")
      (ok (equal "first line" (rev:revision-message r1)))
      (ok (= 72 (length (rev:revision-message r2))))
      (ok (uiop:string-suffix-p (rev:revision-message r2) "…")))))

;;; Opening, listing.

(deftest open-session-by-prefix
  (with-sessions-dir (dir)
    (let ((a (create-session dir :id "abcd0000000000000000000000000000"))
          (b (create-session dir :id "abce0000000000000000000000000000")))
      (commit a "in a")
      (commit b "in b")
      (ok (equal (session-id a) (session-id (open-session dir "abcd"))))
      (ok (equal (session-id b) (session-id (open-session dir "ABCE0000-0000-0000-0000-000000000000"))))
      (let ((c (failure (open-session dir "abc"))))
        (ok (typep c 'session-not-found) "shorter than 4 characters")
        (ok (equal "abc" (and (typep c 'session-not-found) (session-not-found-designator c)))))
      (let ((c (failure (open-session dir "abc0"))))
        (ok (typep c 'session-not-found)))
      (ok (typep (failure (open-session dir "ffff")) 'session-not-found))
      (ok (eql 2 (condition-exit-code (make-condition 'session-not-found :designator "x")))))))

(deftest open-session-ambiguous-prefix
  (with-sessions-dir (dir)
    (let ((a (create-session dir :id "abcd0000000000000000000000000000"))
          (b (create-session dir :id "abcd1111111111111111111111111111")))
      (commit a "a")
      (commit b "b")
      (let ((c (failure (open-session dir "abcd"))))
        (ok (typep c 'session-not-found))
        (ok (has "abcd0000000000000000000000000000" (princ-to-string c)) "names the candidates")
        (ok (has "abcd1111111111111111111111111111" (princ-to-string c)))))))

(deftest list-sessions-newest-first
  (with-sessions-dir (dir)
    (let ((a (create-session dir :id "aaaa0000000000000000000000000000"))
          (b (create-session dir :id "bbbb0000000000000000000000000000"))
          (c (create-session dir :id "cccc0000000000000000000000000000")))
      (at-time (1000) (commit a "old"))
      (at-time (3000) (commit b "new"))
      (at-time (2000) (commit c "middle"))
      (at-time (2500) (commit a "a again"))
      (ok (equal '("bbbb0000000000000000000000000000" "aaaa0000000000000000000000000000"
                   "cccc0000000000000000000000000000")
                 (mapcar #'session-id (list-sessions dir))))
      (ok (equal "aaaa0000000000000000000000000000" (session-id (last-session dir)))
          "last names the session that committed last")
      (ensure-directories-exist (merge-pathnames "junk/" dir))
      (ok (= 3 (length (list-sessions dir))) "a directory without session.sexp is skipped")))
  (with-sessions-dir (dir)
    (ok (null (list-sessions dir)) "no directory: no sessions")
    (ok (null (last-session dir)))))

(deftest session-summary-lines-format
  (with-sessions-dir (dir)
    (let ((a (create-session dir :id "aaaa0000000000000000000000000000"))
          (b (create-session dir :id "bbbb0000000000000000000000000000")))
      (at-time (1000) (commit a (format nil "fix the failing test~%in src/")))
      (at-time (1001) (commit a "and the docs"))
      (at-time (2000) (commit b (make-string 70 :initial-element #\y)))
      (ok (equal (list (format nil "bbbb0000000000000000000000000000  1 turn  ~a…"
                               (make-string 59 :initial-element #\y))
                       "aaaa0000000000000000000000000000  2 turns  fix the failing test")
                 (session-summary-lines dir)))
      (rewind-session b 1)
      (ok (equal "bbbb0000000000000000000000000000  0 turns" (first (session-summary-lines dir)))))))

(deftest create-session-refuses-an-existing-id
  (with-sessions-dir (dir)
    (commit (create-session dir :id "0123456789abcdef0123456789abcdef") "x")
    (let ((c (failure (create-session dir :id "0123456789abcdef0123456789abcdef"))))
      (ok (typep c 'session-error))
      (ok (has "already exists" (princ-to-string c))))
    (ok (typep (failure (create-session dir :id "not an id")) 'session-error))))

(deftest unreadable-revision-file
  (with-sessions-dir (dir)
    (let* ((s (create-session dir :id "0123456789abcdef0123456789abcdef"))
           (r (commit s "x"))
           (file (session-file s "revisions/" (format nil "~a.sexp" (rev:revision-id r)))))
      (write-file (uiop:pathname-directory-pathname file) (file-namestring file) "(:format 1 :id")
      (let ((c (failure (open-session dir (session-id s)))))
        (ok (typep c 'session-error))
        (ok (has (file-namestring file) (princ-to-string c)) "names the file")))))

;;; Concurrency: two stores on one directory stand for two processes.

(deftest second-store-gets-session-conflict
  (with-sessions-dir (dir)
    (let* ((s1 (create-session dir))
           (r0 (commit s1 "zero"))
           (id (session-id s1))
           (a (open-session dir id))
           (b (open-session dir id))
           (ra (commit a "from a")))
      (let ((c (failure (commit b "from b"))))
        (ok (typep c 'session-conflict))
        (when (typep c 'session-conflict)
          (ok (equal (rev:revision-id r0) (session-conflict-expected c)))
          (ok (equal (rev:revision-id ra) (session-conflict-actual c)))
          (ok (equal id (session-error-session c)))
          (ok (has "another process" (princ-to-string c)))))
      (let ((o (open-session dir id)))
        (ok (equal '("zero" "from a") (line-prompts o)) "nothing of b's turn was written")
        (ok (= 2 (length (rev:walk-revisions o (rev:rev-ref +head-ref+)))))
        (ok (= 1 (length (rev:heads o))))))))

(deftest session-conflict-fork-session-restart
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r0 (commit s "zero"))
           (id (session-id s))
           (a (open-session dir id))
           (b (open-session dir id)))
      (commit a "from a")
      (let ((offered nil))
        (multiple-value-bind (rev store)
            (handler-bind ((session-conflict
                             (lambda (c)
                               (setf offered (and (find-restart 'fork-session c) t))
                               (invoke-restart 'fork-session "feedfacefeedfacefeedfacefeedface"))))
              (commit-turn b (simple-record "from b" "B")))
          (ok offered)
          (ok (session-store-p store))
          (ok (equal "feedfacefeedfacefeedfacefeedface" (session-id store)))
          (ok (equal (list (session-id b) (rev:revision-id r0)) (session-cloned-from store)))
          (ok (equal (list (rev:revision-id r0)) (rev:revision-parent-ids rev)))
          (let ((fork (open-session dir "feedfacefeedfacefeedfacefeedface")))
            (ok (equal '("zero" "from b") (line-prompts fork))))
          (ok (equal '("zero" "from a") (line-prompts (open-session dir id)))
              "the original keeps the other process's turn")
          (ok (equal "feedfacefeedfacefeedfacefeedface" (session-id (last-session dir)))))))))

(deftest session-conflict-abort-writes-nothing
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (id (progn (commit s "zero") (session-id s)))
           (a (open-session dir id))
           (b (open-session dir id)))
      (commit a "from a")
      (ok (eq :aborted
              (block run
                (handler-bind ((session-conflict
                                 (lambda (c) (declare (ignore c))
                                   (return-from run :aborted))))
                  (commit b "from b")))))
      (ok (= 1 (length (directory-names dir))) "no fork session was made")
      (ok (= 2 (length (rev:walk-revisions (open-session dir id) (rev:rev-ref +head-ref+))))))))

(deftest commit-turn-explicit-expected
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one"))
           (r2 (commit s "two"))
           (r3 (commit-turn s (simple-record "branch" "b") :expected (rev:revision-id r2))))
      (ok (equal (list (rev:revision-id r2)) (rev:revision-parent-ids r3)))
      (ok (typep (failure (commit-turn s (simple-record "stale" "x") :expected (rev:revision-id r1)))
                 'session-conflict))
      (ok (typep (failure (commit-turn s (simple-record "none" "x") :expected nil)) 'session-conflict)
          ":expected NIL means the head must be absent"))))

(deftest session-lock-timeout
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (lock (progn (commit s "one") (session-file s "lock"))))
      (write-file (uiop:pathname-directory-pathname lock) "lock"
                  (format nil "0 ~d~%" (get-universal-time)))
      (let* ((*session-lock-timeout* 0.3)
             (start (get-internal-real-time))
             (c (failure (commit s "two")))
             (took (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
        (ok (typep c 'session-locked))
        (ok (and (typep c 'session-locked) (same-path lock (session-locked-file c))))
        (ok (>= took 0.25) "it waited")
        (ok (< took 5) "about *session-lock-timeout*"))
      (ok (equal '("one") (line-prompts (open-session dir (session-id s))))))))

(deftest stale-session-lock-is-broken
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (lock (progn (commit s "one") (session-file s "lock"))))
      (write-file (uiop:pathname-directory-pathname lock) "lock"
                  (format nil "0 ~d~%" (- (get-universal-time) (* 2 +stale-lock-seconds+))))
      (let ((*session-lock-timeout* 0.3))
        (ok (rev:revision-p (commit s "two"))))
      (ok (not (probe-file lock)))
      (ok (equal '("one" "two") (line-prompts (open-session dir (session-id s))))))))

(defun write-octets (path octets)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede
                            :element-type '(unsigned-byte 8))
    (write-sequence (coerce octets '(vector (unsigned-byte 8))) out))
  path)

(deftest unreadable-session-lock-is-a-typed-error
  ;; #7: a lock file that cannot be read is a SESSION-LOCK-ERROR (not a wait
  ;; for SESSION-LOCKED); BREAK-LOCK removes it and the write goes on.
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (lock (progn (commit s "one") (session-file s "lock"))))
      (write-octets lock '(#xff #xfe #xfd 10))
      (let* ((*session-lock-timeout* 0.3)
             (c (failure (commit s "two"))))
        (ok (typep c 'session-lock-error))
        (ok (typep c 'session-error) "a session error (exit 1)")
        (when (typep c 'session-lock-error)
          (ok (same-path lock (session-lock-error-file c)))
          (ok (eq :read (session-lock-error-operation c)))
          (ok (session-lock-error-cause c))
          (ok (search "lock file" (princ-to-string c)))))
      (ok (probe-file lock) "nothing was removed")
      (testing "BREAK-LOCK takes it"
        (let* ((offered nil)
               (revision
                 (handler-bind ((session-lock-error
                                  (lambda (c)
                                    (let ((r (find-restart 'break-lock c)))
                                      (setf offered (and r t))
                                      (when r (invoke-restart r))))))
                   (let ((*session-lock-timeout* 0.3))
                     (commit s "two")))))
          (ok (rev:revision-p revision))
          (ok offered "the restart is offered")
          (ok (not (probe-file lock)) "released after the write")
          (ok (equal '("one" "two") (line-prompts (open-session dir (session-id s))))))))))

(deftest vanished-session-lock-is-not-an-error
  ;; #7: the lock file going away between the probe and the read is the
  ;; expected race: no error, nothing to read.
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (lock (progn (commit s "one") (session-file s "lock"))))
      (ok (not (probe-file lock)))
      (ok (null (cl-stack-code::%read-lock-file s lock)))
      (ok (null (cl-stack-code::%stale-lock-p s lock)))
      (ok (null (cl-stack-code::%remove-lock-file s lock))))))

(deftest head-cas-is-linearizable-across-stores
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (id (progn (commit s "root") (session-id s)))
           (stores (list (open-session dir id) (open-session dir id)))
           (errors '())
           (threads
             (loop for store in stores
                   for k from 0
                   collect (let ((store store) (k k))
                             (bt:make-thread
                              (lambda ()
                                (handler-case
                                    (dotimes (i 15)
                                      (handler-bind ((rev:ref-conflict
                                                       (lambda (c) (declare (ignore c))
                                                         (invoke-restart 'rev:retry))))
                                        (rev:commit-revision
                                         store (record-content (simple-record (format nil "~d-~d" k i) "x"))
                                         :ref +head-ref+)))
                                  (error (e) (push e errors))))
                              :name "session committer")))))
      (mapc #'bt:join-thread threads)
      (ok (null errors) (format nil "no errors: ~a" errors))
      (let ((o (open-session dir id)))
        (ok (= 31 (length (session-line o))) "every commit is on the head's line")
        (ok (= 1 (length (rev:heads o))) "no lost update left a dangling head")
        (ok (= 31 (length (rev:walk-revisions o (rev:rev-ref +head-ref+)))))))))

(deftest store-protocol-writes-persist
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one"))
           (r2 (commit s "two")))
      (rev:move-ref s "keep" (rev:revision-id r1))
      (rev:tag-revision s "v1" (rev:revision-id r2) :annotation "first release")
      (rev:move-ref s +head-ref+ (rev:revision-id r1) :expected (rev:revision-id r2))
      (let ((o (open-session dir (session-id s))))
        (ok (equal (rev:revision-id r1) (rev:ref-target (rev:find-ref o "keep"))))
        (ok (eq :tag (rev:ref-kind (rev:find-ref o "v1"))))
        (ok (equal (rev:revision-id r2) (rev:ref-target (rev:find-ref o "v1"))))
        (ok (equal (rev:revision-id r1) (rev:revision-id (session-head o)))))
      (rev:delete-ref s "keep")
      (ok (null (rev:find-ref (open-session dir (session-id s)) "keep"))))))

(deftest sync-session-reads-other-writes
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (id (progn (commit s "one") (session-id s)))
           (a (open-session dir id))
           (b (open-session dir id)))
      (commit a "two")
      (ok (= 1 (length (session-line b))) "b has not read it yet")
      (sync-session b)
      (ok (equal '("one" "two") (line-prompts b)))
      (ok (not (equal (session-base b) (rev:revision-id (session-head b))))
          "a sync does not move the base"))))

;;; Clones, rewinds, forks.

(deftest clone-session-copies-the-line
  (with-sessions-dir (dir)
    (let* ((s (create-session dir :project-dir #p"/tmp/p/"))
           (r1 (commit s "one"))
           (r2 (commit s "two")))
      (move-session-head s (rev:revision-id r1))
      (commit s "side")
      (move-session-head s (rev:revision-id r2))
      (let* ((c (clone-session s :id "c0ffee00c0ffee00c0ffee00c0ffee00"))
             (o (open-session dir "c0ffee00c0ffee00c0ffee00c0ffee00")))
        (ok (equal "c0ffee00c0ffee00c0ffee00c0ffee00" (session-id c)))
        (ok (equal (list (session-id s) (rev:revision-id r2)) (session-cloned-from o)))
        (ok (equal (mapcar #'rev:revision-id (session-line s)) (mapcar #'rev:revision-id (session-line o)))
            "same ids")
        (ok (= 2 (length (rev:walk-revisions o (mapcar #'rev:revision-id (rev:heads o)))))
            "the side branch is not copied")
        (ok (dt:= (rev:revision-recorded-at r1)
                  (rev:revision-recorded-at (first (session-line o)))))
        (ok (same-path #p"/tmp/p/" (session-project-dir o)))
        (ok (equal (session-id c) (session-id (last-session dir))))
        (commit c "three")
        (ok (equal '("one" "two") (line-prompts (open-session dir (session-id s))))
            "the source is untouched")))))

(deftest clone-session-at-a-turn-and-empty
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one")))
      (commit s "two")
      (let ((c (clone-session s :at (rev:revision-id r1))))
        (ok (equal '("one") (line-prompts c))))
      (let ((e (clone-session (create-session dir))))
        (ok (null (session-head e)))
        (ok (probe-file (session-file e "session.sexp")) "a clone is written at once")))))

(deftest rewind-session-moves-the-head-back
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one")))
      (commit s "two")
      (commit s "three")
      (ok (equal (rev:revision-id r1) (rev:revision-id (rewind-session s 2))))
      (ok (equal '("one") (line-prompts s)))
      (ok (= 3 (length (rev:walk-revisions s (mapcar #'rev:revision-id (rev:heads s)))))
          "the rewound turns stay in the store")
      (let ((c (failure (rewind-session s 2))))
        (ok (typep c 'session-turn-not-found))
        (ok (and (typep c 'session-turn-not-found) (eql 2 (session-turn-not-found-designator c)))))
      (ok (null (rewind-session s 1)) "rewinding every turn deletes the head")
      (ok (null (session-head s)))
      (ok (null (session-turns s)))
      (ok (typep (failure (rewind-session s 1)) 'session-turn-not-found))
      (let ((r4 (commit s "fresh")))
        (ok (null (rev:revision-parent-ids r4)) "the next turn is a new root"))
      (ok (null (rev:revision-parent-ids
                 (session-head (open-session dir (session-id s)))))))))

(deftest resolve-turn-designators
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one" "1" :id (concatenate 'string "abcd" (hex-n #\0 36))))
           (r2 (commit s "two" "2" :id (concatenate 'string "abce" (hex-n #\0 36)))))
      (ok (equal (rev:revision-id r1) (rev:revision-id (resolve-turn s "1"))))
      (ok (equal (rev:revision-id r2) (rev:revision-id (resolve-turn s "2"))))
      (ok (equal (rev:revision-id r2) (rev:revision-id (resolve-turn s "abce"))))
      (dolist (bad '("0" "3" "abc" "zzzz" "-1" ""))
        (ok (typep (failure (resolve-turn s bad)) 'session-turn-not-found) bad))
      (let ((c (failure (resolve-turn s "9"))))
        (ok (equal "9" (and (typep c 'session-turn-not-found) (session-turn-not-found-designator c))))))))

(deftest fork-turn-branches-before-a-turn
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one")))
      (commit s "two")
      (multiple-value-bind (head prompt) (fork-turn s nil)
        (ok (equal (rev:revision-id r1) (rev:revision-id head)) "default: before the last turn")
        (ok (equal "two" prompt)))
      (let ((r3 (commit s "two, again")))
        (ok (equal (list (rev:revision-id r1)) (rev:revision-parent-ids r3)))
        (ok (= 2 (length (rev:revision-children s (rev:revision-id r1)))) "two branches"))
      (multiple-value-bind (head prompt) (fork-turn s "1")
        (ok (null head) "forking at the root empties the head")
        (ok (equal "one" prompt)))
      (ok (typep (failure (fork-turn s nil)) 'session-turn-not-found) "nothing left to fork")
      (ok (equal (session-base s) nil)))))

(deftest move-session-head-cas
  (with-sessions-dir (dir)
    (let* ((s (create-session dir))
           (r1 (commit s "one"))
           (id (progn (commit s "two") (session-id s)))
           (a (open-session dir id))
           (b (open-session dir id)))
      (move-session-head a (rev:revision-id r1))
      (ok (typep (failure (move-session-head b (rev:revision-id r1))) 'session-conflict)
          "b still expects the old head")
      (ok (equal (rev:revision-id r1) (rev:revision-id (move-session-head b (rev:revision-id r1)
                                                                          :expected (rev:revision-id r1))))))))
